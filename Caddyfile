# FGMP Caddy gateway
#
# ── SECURITY: the open proxy that used to live here ───────────────────────────
# This file previously routed ANY request carrying `?XTransformPort=<n>` to
# `localhost:<n>`, with no allow-list:
#
#     @transform_port_query { query XTransformPort=* }
#     handle @transform_port_query { reverse_proxy localhost:{query.XTransformPort} }
#
# That let any client name an arbitrary local port (Redis, a Docker socket, an
# internal admin panel) and have Caddy dial it — an open proxy into the
# container network, and a way to reach the unauthenticated realtime socket.
# It is replaced below by a single FIXED upstream for the socket.
#
# ── Listen address ───────────────────────────────────────────────────────────
# `FGMP_SITE_ADDRESS` controls the site address and defaults to `:81`, which is
# exactly what this file did before. Set it to a real hostname to turn on
# automatic HTTPS, e.g.
#     FGMP_SITE_ADDRESS=fgmp.example.com  docker compose up -d

{$FGMP_SITE_ADDRESS::81} {
	encode zstd gzip

	# ── Realtime websocket ──────────────────────────────────────────────────
	# Fixed upstream only — no user-controlled port. The browser's socket.io
	# client connects to `/socket.io` and presents a short-lived signed token in
	# the handshake `auth`; the realtime service rejects unauthenticated sockets.
	handle /socket.io/* {
		reverse_proxy localhost:3003
	}

	# ── Everything else → the Next.js app ───────────────────────────────────
	handle {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# Baseline security headers, applied at the gateway so they hold even for
	# responses the app does not generate (proxy errors, static fallbacks).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
