# FGMP Caddy gateway
#
# ── SECURITY: the open proxy that used to live here ───────────────────────────
# This file previously routed ANY request carrying `?XTransformPort=<n>` to
# `localhost:<n>`, with no allow-list:
#
#     @transform_port_query { query XTransformPort=* }
#     handle @transform_port_query { reverse_proxy localhost:{query.XTransformPort} }
#
# That let any client name an arbitrary local port (Redis, a Docker socket, an
# internal admin panel) and have Caddy dial it — an open proxy into the
# container network, and a way to reach the unauthenticated realtime socket.
# It is replaced below by a single fixed upstream: everything now goes to the
# Next.js app, and the realtime socket itself left this gateway entirely —
# browsers connect to the hosted Apinator WebSocket (wss://ws-<cluster>.
# apinator.io) directly, so there is no socket upstream to name any more.
#
# ── Listen address ───────────────────────────────────────────────────────────
# `FGMP_SITE_ADDRESS` controls the site address and defaults to `:81`, which is
# exactly what this file did before. Set it to a real hostname to turn on
# automatic HTTPS, e.g.
#     FGMP_SITE_ADDRESS=fgmp.example.com  docker compose up -d

{$FGMP_SITE_ADDRESS::81} {
	encode zstd gzip

	# ── Realtime websocket (moved off this gateway) ─────────────────────────
	# The /socket.io/* handle that reverse-proxied the self-hosted realtime
	# mini-service on :3003 is GONE — that service was retired in favour of
	# Apinator. Browsers open their WebSocket straight to
	# wss://ws-<cluster>.apinator.io and authorize channel subscriptions via
	# the app's /api/fgmp/realtime/auth route, which this gateway still
	# proxies as an ordinary API path below. No socket traffic traverses
	# Caddy any more, so no socket-specific handle block is needed.

	# ── Everything else → the Next.js app ───────────────────────────────────
	handle {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

  # Baseline security headers, applied at the gateway so they hold even for
  # responses the app does not generate (proxy errors, static fallbacks).
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}

# ── mTLS internal listener (proposal §7 — الأمان والموثوقية:
#    "تشفير mTLS للاتصالات") ────────────────────────────────────────
# Service-to-service traffic (IoT bridge → app ingestion) rides this
# listener. It is bound to loopback ONLY, so it is reachable from the
# container network but never from a client browser, and every
# connection must present a certificate signed by the deployment CA
# (client_auth require_and_verify) — a stolen API key alone is not
# enough to ingest telemetry or call internal endpoints.
#
# Certificates are generated by scripts/generate-mtls-certs.sh and
# mounted from ./certs (see docker-compose.yml). The files are:
#   ca.crt    — the deployment CA (trust anchor for client certs)
#   server.crt / server.key — this gateway's own certificate
#   client.crt / client.key — the IoT bridge's client certificate
#
# Both server and client certs MUST carry the correct SANs
# (localhost / fgmp-app) or the handshake fails closed.
{$FGMP_MTLS_ADDR:127.0.0.1:8443} {
  tls /certs/server.crt /certs/server.key

  tls {
    protocols tls1.2 tls1.3
    client_auth {
      mode require_and_verify
      trusted_ca_cert /certs/ca.crt
    }
  }

  handle {
    reverse_proxy localhost:3000 {
      header_up Host {host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote_host}
      header_up X-SSL-Client-Verify {tls_client_verified}
      header_up X-SSL-Client-CN {tls_client_sni}
    }
  }
}
