// FGMP — Fuel & Generator Monitoring Platform
// Prisma schema (PostgreSQL).
//
// Phase 1 step 1 migrated this from SQLite to PostgreSQL. Two consequences
// worth stating explicitly, because the SQLite version made both impossible:
//
//   * Enums can now be native `enum` types. The SQLite build stored every
//     discriminator as a free `String` with the legal values documented only in
//     a comment — nothing but application code prevented an invalid value from
//     reaching the database. Native enums land in step 8.
//   * RLS (step 6) is only meaningful on PostgreSQL. On SQLite there was no
//     database-enforced tenant boundary at all: isolation was entirely
//     application-level, so a single missed `assertTenantOwned` was a
//     cross-tenant data breach — exactly the Phase 0 geography IDOR.
//
// Remaining migration steps: nullable tenant_id (2), backfill (3), NOT NULL +
// FK (4), tenant_id-leading indexes (5), RLS (6), per-request context (7),
// native enums (8), Float -> Decimal (9), TimescaleDB hypertables (10), RLS
// regression suite (11).

generator client {
  provider        = "prisma-client-js"
  // Cloudflare Workers cannot load Prisma's native Rust query engine. The
  // client engine uses the PostgreSQL driver adapter configured in db.ts.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────
// Phase 5 task 1 — the Float / Decimal boundary, and why it sits there
// ──────────────────────────────────────────────────────────────────────────
//
// Money and VOLUME are Decimal. Everything else stays Float. The line is not
// "important numbers" — it is specifically ACCUMULATION and RECONCILIATION:
//
//   Decimal where a value is (a) counted up over time, or (b) later compared
//   against another recorded quantity to decide whether something went wrong.
//     - litres, capacities, thresholds  (a tank's balance must reconcile)
//     - totalizerLitres                 (monotonic lifetime accumulator)
//     - amountYer / unitPrice           (money)
//   Float where the value is a re-read instrument sample that is replaced on
//   the next reading and never summed into a balance:
//     - voltage, current, temperature, load, oil pressure, SoH/SoC
//     - SensorReading.value, lat/long, CPU temp, MQTT latency
//
// Why the asymmetry is safe: float error in a telemetry sample is bounded by
// the sample's own magnitude and disappears when the next sample overwrites
// it. Float error in an ACCUMULATOR is monotonic — it never cancels — so it
// compounds for the life of the row. totalizerLitres is the case that
// matters: it accumulates across months of dispensing, and its drift lands
// directly in a fuel-reconciliation comparison, where it is indistinguishable
// from theft in either direction.
//
// Deliberately still Float, despite being volume-derived:
//   - fuelRateLph, flowRateLpm, maxFlowLpm — RATES and LIMITS, not balances.
//     A rate is re-derived each tick and compared against a configured
//     ceiling; nothing accumulates them. Their precision need is "is this
//     above the limit", not "reconcile to the litre".
//   - capacityAh, ratedPowerKw, capacityKwp — static nameplate ratings that
//     never change and are never summed.
//
// The test for any future column: does it accumulate, or does it participate
// in a reconciliation? If either, it is Decimal. That is the whole rule.
// ──────────────────────────────────────────────────────────────────────────

// ──────────────────────────────────────────────────────────────────────────
// Native enums (Phase 1 step 8)
// ──────────────────────────────────────────────────────────────────────────
// Phase 1 step 1 moved the datasource to PostgreSQL, which makes native enum
// types possible for the first time. Under SQLite every discriminator below was
// a free `String` whose legal values existed only in a comment — nothing but
// application code prevented an invalid value reaching the database.
//
// IMPORTANT — these value lists were reconciled against the actual runtime
// writers, NOT copied from the documentation comments above each model. Four
// documented lists were incomplete, and a native enum built from them alone
// would have rejected values the application legitimately writes:
//
//   * User.role               — the comment omitted SUPERADMIN (types.ts `Role`).
//   * Notification.channel    — the comment listed none; engine.ts writes SMS,
//                               EMAIL and WHATSAPP.
//   * MaintenanceTicket.status — writers produce SCHEDULED / IN_PROGRESS /
//                               DONE / CANCELLED.
//   * FuelDelivery.status     — DISCREPANCY is declared but never written
//                               (kept: a legitimate terminal state).
//
// Deliberately NOT enum-ised — open/extensible or write-once audit values where
// a native enum adds write-time rejection with no integrity benefit:
// AlarmSuppression.status/priority, SiteEvent.kind, AuditLog.action,
// ApiKey.scopes, SystemSetting.type, and BackupRecord.kind/status (the latter
// also orphaned after Phase 0 deleted the backup API).
//
// MaintenanceTicket.type/.assetKind and IotDevice.type stay String: the ticket
// pair is constrained by zod at the API boundary (schemas.ts), and IotDevice.type
// has no documented closed set.

// SUPERADMIN is the platform cross-tenant owner, enforced server-side in
// rbac.ts / auth-helpers.ts. The old `role` comment above model User omitted it.
enum Role {
  SUPERADMIN
  ADMIN
  NOC_OPERATOR
  REGIONAL_MANAGER
  FIELD_ENGINEER
  EXECUTIVE
  READONLY
}

enum SiteStatus {
  ONLINE
  DEGRADED
  OFFLINE
  MAINTENANCE
}

enum Criticality {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum PowerSource {
  GRID
  GENERATOR
  HYBRID
}

enum TankStatus {
  OPERATIONAL
  EMPTY
  MAINTENANCE
  CALIBRATING
}

enum FuelType {
  DIESEL
  PETROL
  // BIOFUEL was missing from the first cut of this enum: it was built from the
  // FuelDispenser doc comment (schema.prisma:608, "DIESEL | PETROL") and
  // missed the FuelTank one (":456", "DIESEL | PETROL | BIOFUEL"). Four API
  // routes validate input against ["DIESEL","PETROL","BIOFUEL"], so the enum
  // would have rejected a value the API accepts. Adding an enum value is
  // strictly safer than dropping one: it cannot break an existing writer,
  // whereas removing BIOFUEL would reject requests users can already make.
  BIOFUEL
}

enum GenStatus {
  RUNNING
  STOPPED
  FAULT
  MAINTENANCE
  OFFLINE
}

enum GenMode {
  AUTO
  MANUAL
  REMOTE
}

enum GenCommandType {
  START
  STOP
  EMERGENCY_STOP
  RESET
}

enum BatteryStatus {
  OK
  LOW
  FAILING
  REPLACEMENT_DUE
  OFFLINE
}

enum EntityKind {
  TANK
  GENERATOR
  BATTERY
  SITE
  DISPENSER
}

enum IotProtocol {
  RS485
  MODBUS_RTU
  MODBUS_TCP
  MQTT
  HTTP
  SNMP
}

enum IotStatus {
  ONLINE
  OFFLINE
  DEGRADED
  PROVISIONING
}

enum DispenserStatus {
  IDLE
  AUTHORIZED
  DISPENSING
  STOPPED
  FAULT
  MAINTENANCE
  OFFLINE
}

enum FuelTransactionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED
}

enum AlarmType {
  FUEL_THEFT
  FUEL_REFILL
  FUEL_LOW
  FUEL_CRITICAL
  GEN_OFFLINE
  GEN_FAILURE
  GEN_OVERHEAT
  BATT_LOW_VOLTAGE
  BATT_FAILURE
  COMM_LOSS
  DISPENSER_FAULT
}

enum AlarmSeverity {
  L1
  L2
  L3
}

enum AlarmStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  ESCALATED
}

enum FuelDeliveryStatus {
  SCHEDULED
  IN_TRANSIT
  DELIVERED
  VERIFIED
  DISCREPANCY
  CANCELLED
}

enum ControlCommandStatus {
  PENDING
  SENT
  EXECUTED
  FAILED
  TIMEOUT
  // Phase 5: the command was overtaken by a newer command for the same
  // generator and will never now run. Genuinely TERMINAL, and deliberately
  // distinct from FAILED — nothing went wrong, the command simply lost the race.
  // Collapsing it into FAILED would tell an operator the generator rejected a
  // start when in fact a later start superseded it.
  SUPERSEDED
}

enum TicketPriority {
  P1
  P2
  P3
  P4
}

enum TicketStatus {
  OPEN
  SCHEDULED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  // Phase 4: the notification was created and the operator is entitled to it,
  // but NO TRANSPORT EXISTS for its channel — there is no SMTP host, webhook or
  // SMS provider configured. This is deliberately NOT "FAILED": nothing was
  // attempted, so nothing failed, and reporting a configuration gap as a delivery
  // failure would send an operator hunting a broken provider that does not
  // exist.
  //
  // It is equally deliberately NOT "SENT". Collapsing these three states into
  // one is the defect this member exists to make visible:
  //
  //   NO_TRANSPORT -> nobody is configured to receive this class of alert
  //   FAILED       -> a real transport was tried and the send failed
  //   SENT         -> a real transport accepted it
  //
  // An operator must be able to tell those apart, because they are three
  // different operational problems with three different fixes.
  NO_TRANSPORT
}

enum SystemSettingCategory {
  ALARM
  ESCALATION
  BRANDING
  PLATFORM
  FORECAST
}

enum GatewayStatus {
  ONLINE
  OFFLINE
  DEGRADED
}

enum OtaStatus {
  // QUEUED is the real initial state: engine.ts creates every
  // EspFirmwareDeployment with status "QUEUED" (5 sites), and it is the
  // value documented on EspFirmwareDeployment.status. It was missing from
  // the enum, which made the default unresolvable.
  QUEUED
  IDLE
  PENDING
  DOWNLOADING
  FLASHING
  SUCCESS
  FAILED
  ROLLED_BACK
}

// ──────────────────────────────────────────────────────────────────────────
// Phase 2 — server-side alarm correlation (vertical 4)
// ──────────────────────────────────────────────────────────────────────────

/// Geographic scope a correlation rule groups alarms by.
enum RuleScope {
  SITE
  REGION
  GOVERNORATE
  NATIONAL
}

/// The alarm type a rule counts.
///
/// `ANY` is a real enum member rather than a TypeScript-only sentinel so the
/// database can store it and the RLS/CHECK constraints apply to it. It cannot
/// collide with a genuine alarm type because it is not a member of AlarmType.
enum RuleAlarmType {
  ANY
  FUEL_THEFT
  FUEL_REFILL
  FUEL_LOW
  FUEL_CRITICAL
  GEN_OFFLINE
  GEN_FAILURE
  GEN_OVERHEAT
  BATT_LOW_VOLTAGE
  BATT_FAILURE
  COMM_LOSS
  DISPENSER_FAULT
}

/// Outcome of evaluating one rule against the event stream.
enum RuleEvaluationOutcome {
  /// Threshold not reached, or the rule is disabled.
  NOT_TRIGGERED
  /// LEGACY. Written by service.ts before Phase 5, which recorded
  /// `SUPPRESSED` unconditionally and then took no action, so a row with this
  /// value does NOT mean anything was suppressed. Retained so historical rows
  /// stay readable; nothing writes it any more.
  SUPPRESSED
  /// The match fired AND at least one referenced alarm was actually raised to
  /// the rule's `escalateTo` severity. The only outcome that asserts an action
  /// was taken.
  ESCALATED
  /// The match fired but nothing was changed: either the rule has no
  /// `escalateTo`, or every referenced alarm was already at or above the target
  /// (severity is never lowered). Recorded honestly rather than recorded as a
  /// suppression that did not happen.
  ESCALATION_NOOP
}

model CorrelationRule {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  description String        @default("")
  enabled     Boolean       @default(true)
  /// ANY counts alarms of every type.
  alarmType   RuleAlarmType
  /// How many matching alarms inside the window are required.
  threshold   Int           @default(1)
  /// Rolling window length in minutes, ending at evaluation time.
  windowMinutes Int         @default(5)
  scope       RuleScope     @default(SITE)
  /// Severity assigned to the correlated group when the rule fires.
  escalateTo  AlarmSeverity @default(L2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  matches CorrelationMatch[]

  @@index([tenantId, enabled])
  @@index([tenantId, updatedAt])
}

/// One rule firing against one geographic bucket at one evaluation time.
///
/// This table is the idempotency ledger, and the UNIQUE constraint is what
/// makes re-evaluation safe: the same rule firing against the same scope
/// bucket for the same set of member alarms can be INSERTed exactly once.
/// Re-running evaluation over an unchanged event stream produces a constraint
/// violation that is caught and treated as "already applied" — not a duplicate
/// suppression.
model CorrelationMatch {
  id        String              @id @default(cuid())
  tenantId  String
  ruleId    String
  /// Geographic bucket key: site id, region id, governorate id, or "__ALL__".
  /// Persisted rather than a label so the UNIQUE constraint is on stable data.
  scopeKey  String
  scope     RuleScope
  /// Human-readable label for display (e.g. "Region: Central Highlands").
  scopeLabel String
  outcome   RuleEvaluationOutcome
  escalateTo AlarmSeverity
  /// How many alarms satisfied the threshold.
  matchCount Int
  /// Sorted member alarm ids, joined with ",".
  ///
  /// This is the second half of the idempotency key and is what distinguishes
  /// "the same event set again" (duplicate — ignored) from "the same bucket
  /// gained another alarm" (a genuinely new match — recorded).
  alarmIds  String
  /// The instant the rule was evaluated, so the match is auditable.
  evaluatedAt DateTime          @default(now())
  createdAt   DateTime          @default(now())
  /// Phase 5 — how many referenced alarms this match actually RAISED.
  ///
  /// The UNIQUE constraint on (ruleId, scopeKey, alarmIds) dedupes the MATCH
  /// row, which is NOT the same as deduping the ACTION: a rule re-evaluating
  /// the same alarm set would insert nothing but must also not re-apply an
  /// escalation. This count, recorded at the same transaction as the severity
  /// write, is what makes "did this action already happen?" answerable from the
  /// database rather than inferred.
  escalatedCount Int               @default(0)
  /// Per-alarm BEFORE severities, JSON: {"<alarmId>":"L2", …}.
  ///
  /// Stored because the escalation overwrites `Alarm.severity` in place, so
  /// without this the original value is unrecoverable and the change can only be
  /// asserted, never reconstructed. Null for rows written before Phase 5.
  fromSeverity   Json?

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rule   CorrelationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, scopeKey, alarmIds])
  @@index([tenantId, evaluatedAt])
  @@index([tenantId, scope])
}

// ──────────────────────────────────────────────────────────────────────────
// Identity & Multi-tenancy
// ──────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  sites         Site[]
  suppressions  AlarmSuppression[]
  // Task 48 — tenant-scoped backup history (MANUAL / AUTOMATIC / PRE_RESTORE).
  backupRecords BackupRecord[]
  // Phase 1 steps 2-5: every tenant-owned table carries a `tenantId` FK so the
  // RLS backstop (step 6) rests on a real constraint. These reverse relations
  // exist only to give Prisma a referential path to `Tenant`.
  regions                  Region[]
  alarms                   Alarm[]
  auditLogs                AuditLog[]
  notifications            Notification[]
  apiKeys                  ApiKey[]
  shiftHandovers           ShiftHandover[]
  tanks                    FuelTank[]
  generators               Generator[]
  batteries                BatteryBank[]
  iotDevices               IotDevice[]
  dispensers               FuelDispenser[]
  fuelTransactions         FuelTransaction[]
  sensorReadings           SensorReading[]
  siteEvents               SiteEvent[]
  fuelDeliveries           FuelDelivery[]
  controlCommands          ControlCommand[]
  interlockOverrides      InterlockOverride[]
  thresholds              InterlockThreshold[]
  maintenanceTickets       MaintenanceTicket[]
  siteGateways             SiteGateway[]
  notificationPreferences  NotificationPreference[]
  espFirmwareDeployments   EspFirmwareDeployment[]
  // Phase 2 — server-side alarm correlation.
  correlationRules         CorrelationRule[]
  correlationMatches       CorrelationMatch[]
  rs485Buses            Rs485Bus[]
  rs485Diagnostics      Rs485BusDiagnostic[]
  rs485LatencySamples   Rs485LatencySample[]
  // Phase 4 — Solar
  solarSites              SolarSite[]
  solarArrays             SolarArray[]

  mfaEnrollments    MfaEnrollment[]
  mfaBackupCodes    MfaBackupCode[]
  mfaChallenges     MfaChallenge[]
  mfaResetRequests  MfaResetRequest[]

}

// role: ADMIN | NOC_OPERATOR | REGIONAL_MANAGER | FIELD_ENGINEER | EXECUTIVE | READONLY
model User {
  id            String    @id @default(cuid())
  tenantId      String
  email         String    @unique
  name          String
  role          Role    @default(NOC_OPERATOR)
  phone         String?
  // bcrypt-hashed password. Nullable for legacy / SSO users that have no
  // local password; the user-management UI always sets a hash on creation
  // and exposes a separate "Reset Password" action.
  passwordHash         String?
  active               Boolean   @default(true)
  lastLoginAt          DateTime?
  // Brute-force protection (Task 31-A). After 5 consecutive failed logins
  // the account is locked for 15 minutes; a successful login resets both.
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  auditLogs  AuditLog[]
  commands   ControlCommand[]
  alarmsAck  Alarm[]     @relation("AlarmAckedBy")
  alarmsRes  Alarm[]     @relation("AlarmResolvedBy")
  tickets    MaintenanceTicket[] @relation("TicketAssignee")
  suppressions AlarmSuppression[]
  notificationPreference NotificationPreference?
  // Task 48 — backup & OTA reverse relations.
  backupRecordsCreated  BackupRecord[] @relation("BackupCreatedBy")
  backupRecordsRestored BackupRecord[] @relation("BackupRestoredBy")
  espFirmwareDeployments EspFirmwareDeployment[]
  // Phase 2 — two-person interlock overrides. Named relations because the same
  // user appears twice per row, once as requester and once as approver.
  interlockOverridesRequested InterlockOverride[] @relation("InterlockOverrideRequested")
  interlockOverridesApproved  InterlockOverride[] @relation("InterlockOverrideApproved")
  thresholdsConfirmed        InterlockThreshold[]   @relation("ThresholdConfirmedBy")

  @@index([tenantId])

  mfaEnrollment     MfaEnrollment?
  mfaChallenges     MfaChallenge[]
  mfaResetTargets   MfaResetRequest[] @relation("MfaResetTarget")
  mfaResetRequested MfaResetRequest[] @relation("MfaResetRequested")
  mfaResetApproved  MfaResetRequest[] @relation("MfaResetApproved")

}

// ──────────────────────────────────────────────────────────────────────────
// Geography hierarchy: Region -> Governorate -> District -> Site
// ──────────────────────────────────────────────────────────────────────────

model Region {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  governorates Governorate[]
  sites        Site[]

  // Phase 1: tenantId existed but had NO FK to Tenant, so nothing constrained
  // it. The RLS backstop is weak on an unconstrained column — a bad write
  // would be permanently invisible to every policy. Added here.
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Governorate {
  id        String   @id @default(cuid())
  regionId  String
  name      String
  createdAt DateTime @default(now())

  region     Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  districts  District[]
  sites      Site[]

  @@unique([regionId, name])
}

model District {
  id             String   @id @default(cuid())
  governorateId  String
  name           String
  createdAt      DateTime @default(now())

  governorate Governorate @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  sites       Site[]

  @@unique([governorateId, name])
}

// ──────────────────────────────────────────────────────────────────────────
// Site & assets
// ──────────────────────────────────────────────────────────────────────────

// status: ONLINE | DEGRADED | OFFLINE | MAINTENANCE
// criticality: CRITICAL | HIGH | MEDIUM | LOW
model Site {
  id            String   @id @default(cuid())
  tenantId      String
  code          String   @unique
  name          String
  regionId      String
  governorateId String
  districtId    String
  latitude      Float
  longitude     Float
  address       String
  status        SiteStatus   @default(ONLINE)
  criticality   Criticality   @default(MEDIUM)
  // Load profile (kW)
  loadKw        Float    @default(0)
  /// Phase 4 — the load that must stay energised whatever else is shed. This is
  /// the quantity that decides what may be shed without blacking the site out,
  /// and it is what SHED_BELOW_SITE_REQUIREMENT checks. 0 means "nothing
  /// declared"; the interlock treats 0 as "no floor declared" and NOT as
  /// "free to shed everything", because an undeclared floor must never become
  /// a licence to black out a site.
  protectedLoadKw Float   @default(0)
  // Power preference: GRID | GENERATOR | HYBRID
  powerSource   PowerSource   @default(HYBRID)
  gridAvailable Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  region       Region       @relation(fields: [regionId], references: [id])
  governorate  Governorate  @relation(fields: [governorateId], references: [id])
  district     District     @relation(fields: [districtId], references: [id])

  tanks        FuelTank[]
  generators   Generator[]
  batteries    BatteryBank[]
  iotDevices   IotDevice[]
  dispensers   FuelDispenser[]
  rs485Buses   Rs485Bus[]
  dispenserTransactions FuelTransaction[]
  // Task 48 — site-level ESP32/RS485 edge gateways aggregating dispenser traffic.
  gateways     SiteGateway[]
  alarms       Alarm[]
  deliveries   FuelDelivery[]
  tickets      MaintenanceTicket[]
  events       SiteEvent[]
  suppressions AlarmSuppression[]
  thresholds    InterlockThreshold[]
  solarSite     SolarSite?

  @@index([tenantId])
  @@index([regionId])
  @@index([governorateId])
  @@index([districtId])
}

// fuelType: DIESEL | PETROL | BIOFUEL
// status: OPERATIONAL | EMPTY | MAINTENANCE | CALIBRATING
model FuelTank {
  id            String   @id @default(cuid())
  siteId        String
  // Phase 1 step 2-5: denormalised from the parent Site so the RLS policy is a
  // local `tenant_id = ...` predicate rather than a join. Backfilled from
  // Site.tenantId; ON DELETE RESTRICT, not CASCADE — a tenant holding assets
  // must not be deletable.
  tenantId      String
  label         String
  fuelType      FuelType   @default(DIESEL)
  // Phase 5 task 1: volume is Decimal, not Float. `totalizerLitres` is a
  // lifetime accumulator, so float error is monotonic — it compounds and never
  // cancels — and the drift surfaces as a volume mismatch that reads as theft.
  // 3dp on litres is millilitre resolution: finer than any dispenser flow
  // meter, coarser than the float noise it removes. See
  // 20261009000000_volume_columns_to_decimal for the rounding rationale.
  capacityLitres Decimal @db.Decimal(12, 3)
  // Current live level (litres) — updated by telemetry engine & persisted on tick
  currentLitres Decimal @db.Decimal(12, 3)
  // Calibration curve: JSON array of [{litres, percent}] strapping points
  calibration   String
  // Thresholds (litres)
  lowThreshold  Decimal @db.Decimal(12, 3)
  criticalThreshold Decimal @db.Decimal(12, 3)
  // Telemetry meta
  lastReadingAt DateTime?
  status        TankStatus   @default(OPERATIONAL)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deliveries FuelDelivery[]

  // Phase 1 step 5: the RLS policy filters on tenantId, so the index leads
  // with it. The original siteId index is kept for the existing access paths.
  @@index([tenantId])
  @@index([tenantId, siteId])
  @@index([siteId])
}

// status: RUNNING | STOPPED | FAULT | MAINTENANCE | OFFLINE
// mode: AUTO | MANUAL | REMOTE
model Generator {
  id              String   @id @default(cuid())
  siteId          String
  // Phase 1 step 2-5: denormalised from Site. ControlCommand backfills from
  // this column via `generatorId` (ControlCommand has no siteId of its own).
  tenantId        String
  label           String
  manufacturer    String
  model           String
  ratedPowerKw    Float
  fuelType        String   @default("DIESEL")
  status          GenStatus   @default(STOPPED)
  mode            GenMode   @default(AUTO)
  runtimeHours    Float    @default(0)
  // Maintenance
  oilChangeIntervalHrs Float @default(250)
  lastOilChangeHrs     Float @default(0)
  nextMaintenanceHrs   Float @default(250)
  // Live telemetry (updated by engine)
  temperatureC     Float   @default(65)
  oilPressureKpa   Float   @default(320)
  loadKw           Float   @default(0)
  fuelRateLph      Float   @default(0)
  batteryVoltage   Float   @default(24)
  lastStartedAt    DateTime?
  lastStoppedAt    DateTime?
  lastReadingAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  site     Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  commands ControlCommand[]
  interlockOverrides InterlockOverride[]

  @@index([tenantId])
  @@index([tenantId, siteId])
  @@index([siteId])
}

// status: OK | LOW | FAILING | REPLACEMENT_DUE | OFFLINE
model BatteryBank {
  id            String   @id @default(cuid())
  siteId        String
  tenantId      String   // Phase 1 step 2-5: denormalised from Site.
  label         String
  chemistry     String   @default("VRLA")
  capacityAh    Float
  nominalVoltage Float   @default(48)
  // Live telemetry
  voltage       Float    @default(48)
  currentA      Float    @default(0)
  stateOfCharge Float    @default(80)   // %
  stateOfHealth Float    @default(95)   // %
  temperatureC  Float    @default(25)
  charging      Boolean  @default(false)
  status        BatteryStatus   @default(OK)
  installedAt   DateTime @default(now())
  // Last discharge / service date, used for battery health scoring.
  lastReadingAt DateTime?
  updatedAt     DateTime @updatedAt
  // Phase 4 additions
  /// Total charge/discharge cycles since install. Null = no history recorded.
  /// Nullable because an existing bank has no cycle history; inventing 0 would
  /// assert a measurement nobody made.
  cycleCount    Int?
  /// Signed cell imbalance in millivolts, as reported by the BMS via Modbus.
  /// Nullable for the same reason — an operator must be able to distinguish
  /// "balanced" from "unmeasured".
  cellBalanceMv Int?

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, siteId])
  @@index([siteId])
}

// type: FUEL_SENSOR | GENERATOR_CONTROLLER | BATTERY_SENSOR | POWER_METER | ENVIRONMENTAL
// protocol: RS485 | MODBUS_RTU | MODBUS_TCP | MQTT | HTTP | SNMP
// status: ONLINE | OFFLINE | DEGRADED | PROVISIONING
model IotDevice {
  id          String   @id @default(cuid())
  siteId      String
  tenantId    String   // Phase 1 step 2-5: denormalised from Site.
  name        String
  type        String
  protocol    IotProtocol
  vendor      String
  serialNo    String   @unique
  firmware    String
  ipAddress   String?
  modbusUnit  Int?
  // Online state
  status      IotStatus   @default(ONLINE)
  lastSeenAt  DateTime?
  signalRssi  Int      @default(-70)
  // OTA
  otaTargetFw String?
  otaStatus   String?  // PENDING | IN_PROGRESS | COMPLETE | FAILED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, siteId])
  @@index([siteId])
}

// ──────────────────────────────────────────────────────────────────────────
// Fuel Dispensers (Task 34-B)
// ──────────────────────────────────────────────────────────────────────────
// A fuel dispenser is a physical pump at a site, controlled by an ESP32 /
// ESP8266 board that talks to the platform over RS485 (Modbus RTU). Each
// dispenser has 1–4 nozzles and reports live transaction telemetry
// (in-progress volume, flow rate, totalizer) plus the per-fueling-event
// audit trail (FuelTransaction rows).
//
// status: IDLE | AUTHORIZED | DISPENSING | STOPPED | FAULT | MAINTENANCE | OFFLINE
// mode:   AUTO | MANUAL | LOCKED
// fuelType: DIESEL | PETROL
model FuelDispenser {
  id            String   @id @default(cuid())
  siteId        String
  tenantId      String   // Phase 1 step 2-5: denormalised from Site. Also the
                        // Tier A backfill path for EspFirmwareDeployment.
  label         String
  manufacturer  String
  model         String
  nozzleCount    Int      @default(1)   // 1–8 nozzles (proposal §5.4)
  fuelType      FuelType   @default(DIESEL) // DIESEL | PETROL
  maxFlowLpm    Float    @default(40)  // max litres/min
  status        DispenserStatus   @default(IDLE)
  mode          String   @default("AUTO")
  // Pump identifier 1..N within a site (unique per site). Task 48 — required
  // by /api/fgmp/assets/dispensers (create + unique constraint siteId_pumpNumber),
  // /api/fgmp/dispensers/reports (select + response), and
  // /api/fgmp/edge/firmware/deployments (nested select on dispenser).
  pumpNumber    Int      @default(1)

  // ── ESP controller info ────────────────────────────────────────────────
  espDeviceId     String  @unique       // ESP32 / ESP8266 board id
  espFirmware     String  @default("v1.0.0")
  rs485Baudrate   Int     @default(9600)
  rs485Address    Int     @default(1)   // modbus unit address 1–247
  rs485Parity     String  @default("8N1")
  wifiRssi        Int     @default(-65)
  ipAddress       String?
  /// MAC of the industrial controller's network interface. The
  /// proposal's pump card (§8.17) shows it next to the IP, Modbus
  /// address and baud rate as the controller identity.
  macAddress      String?
  lastCommAt      DateTime?

  // ── Live telemetry (updated by engine tick) ───────────────────────────
  // Phase 5 task 1 — volume is Decimal. totalizerLitres is the important one:
  // it accumulates across months of dispensing, so float drift is monotonic.
  currentVolumeLitres  Decimal  @default(0) @db.Decimal(12, 3)   // in-progress transaction volume
  presetVolumeLitres   Decimal? @db.Decimal(12, 3)                // optional preset limit
  flowRateLpm          Decimal  @default(0) @db.Decimal(12, 3)
  totalizerLitres      Decimal  @default(0) @db.Decimal(12, 3)   // cumulative lifetime volume
  currentTransactionId String?
  lastTransactionAt    DateTime?
  tempC                Float    @default(35)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site         Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  transactions FuelTransaction[]
  // Task 48 — reverse relation for OTA firmware deployments targeting this dispenser.
  espFirmwareDeployments EspFirmwareDeployment[]

  @@index([tenantId])
  @@index([tenantId, siteId])
  @@index([siteId])
  @@index([status])
  // Task 48 — pump identifier 1..N is unique within a site. Referenced by
  // /api/fgmp/assets/dispensers as the `siteId_pumpNumber` compound unique key.
  @@unique([siteId, pumpNumber])
}

// ──────────────────────────────────────────────────────────────────────────
// Fuel Transactions (Task 34-B)
// ──────────────────────────────────────────────────────────────────────────
// Each fueling event on a dispenser. Persisted on completion; the in-progress
// one lives in FuelDispenser.currentTransactionId until the engine finalizes
// it (volume → totalizer → tank decrement).
//
// status: IN_PROGRESS | COMPLETED | CANCELLED | FAILED
model FuelTransaction {
  id            String    @id @default(cuid())
  dispenserId   String
  siteId        String
  tenantId      String    // Phase 1 step 2-5: denormalised from Site.
  nozzle        Int       @default(1)
  volumeLitres  Decimal  @db.Decimal(12, 3)
  amountYer     Decimal     @default(0)   // cost in Yemeni Rial
  unitPriceYer  Decimal     @default(0)
  vehiclePlate  String?
  operatorName  String?
  status        FuelTransactionStatus    @default(COMPLETED)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  durationSec   Int       @default(0)
  /// Cumulative pump counter (totalizer) at the moment the
  /// transaction completed — the "عدّاد" column of the proposal's
  /// fill-operations table (§8.17). Null on rows written before
  /// the column existed; those are historical seed rows only.
  totalizerLitres Decimal?  @db.Decimal(12, 3)
  createdAt     DateTime  @default(now())

  dispenser FuelDispenser @relation(fields: [dispenserId], references: [id], onDelete: Cascade)
  site      Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, siteId])
  @@index([dispenserId, startedAt])
  @@index([siteId, startedAt])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────────────────
// Time-series readings (aggregated; high-frequency telemetry stays in-memory)
// ──────────────────────────────────────────────────────────────────────────

// metric: FUEL_LEVEL | GEN_TEMP | GEN_RUNTIME | BATT_VOLTAGE | BATT_SOC | LOAD_KW | FUEL_RATE
// entityKind: TANK | GENERATOR | BATTERY | SITE
// ─────────────────────────────────────────────────────────────────────────────
// READ THIS BEFORE REGENERATING THIS MODEL. IT WILL REVERT THE HYPERTABLE.
//
// The database primary key for this table is (id, ts) on a server with the
// TimescaleDB extension — see migration 20261012000000_sensor_reading_hypertable:
//     ALTER TABLE "SensorReading"
//       ADD CONSTRAINT "SensorReading_pkey" PRIMARY KEY ("id", "ts");
//
// `id @id` below does NOT contradict that; it is the honest declaration for a
// PostgreSQL server WITHOUT the extension. Prisma cannot express a partition key
// inside a composite primary key, so this schema can never record what the
// migration actually did.
//
// That gap is a booby trap. `prisma migrate dev` diffs the schema against the
// migration history, concludes the key should be ("id") alone, and emits:
//
//     DROP INDEX "SensorReading_ts_idx";
//     ALTER TABLE "SensorReading" DROP CONSTRAINT "SensorReading_pkey",
//       ADD CONSTRAINT "SensorReading_pkey" PRIMARY KEY ("id");
//
// On a TimescaleDB server that REVERTS the hypertable conversion. It does not
// error — it succeeds, the table silently stops being a hypertable, and the
// dedup guarantee changes shape underneath the ingest path. This fired once
// while adding the `tsSource` column, and was caught only because the generated
// SQL was read before applying it.
//
// SO: do not accept Prisma-generated SQL for this table. Add the column by hand
// and leave the primary key alone. `hypertable-pk-invariant.test.ts` enforces
// this — it reads the migration set and fails if any migration regresses the key
// to a single column.
// ─────────────────────────────────────────────────────────────────────────────
model SensorReading {
  id          String   @id @default(cuid())
  siteId      String
  tenantId    String   // Phase 1 step 2-5: denormalised from Site.
  entityKind  EntityKind
  entityId    String
  metric      String
  value       Float
  ts          DateTime @default(now())
  // WHERE THE IDENTITY OF THIS READING CAME FROM.
  //
  // `ts` is the identity of a measurement and UNIQUE(entityId, metric, ts) is
  // the replay guarantee. A device that omits `ts` gets SERVER time, which is
  // NOT the reading's identity — a retry then lands on a different timestamp and
  // is accepted again. Recording the source makes that blind spot visible and
  // measurable instead of silent, so a device replaying an unsynced clock buffer
  // can be counted and alarmed on.
  //
  // The dedup guarantee is claimed ONLY where this is DEVICE.
  tsSource    String   @default("DEVICE")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Step 5 note: this is the table step 10 turns into a hypertable, so the
  // tenant-leading index is also the one the RLS predicate rides on. Keeping
  // (tenantId, ts) lets a per-tenant time-range scan use one index for both.
  @@index([tenantId])
  @@index([tenantId, ts])
  @@index([siteId, ts])
  // Phase 4 item 4. This was a NON-unique index, so a replayed reading was only
  // UNLIKELY to duplicate, never impossible. Making it UNIQUE turns the ingest
  // duplicate check from a best-effort process-local heuristic into a database
  // guarantee: two replicas receiving the same retry both attempt the insert
  // and exactly one succeeds, whether or not they share memory, cache or a
  // Redis connection.
  //
  // This is why the DATABASE is the authority for the watermark and not Redis.
  // A cache can be evicted, flushed, partitioned or absent, and a miss on a
  // stale cache entry lets a duplicate straight through. A unique constraint
  // survives a total cache outage precisely because it does not depend on the
  // cache existing.
  @@unique([entityId, metric, ts])
}

// ──────────────────────────────────────────────────────────────────────────
// Alarms
// ──────────────────────────────────────────────────────────────────────────

// type: FUEL_THEFT | FUEL_REFILL | FUEL_LOW | FUEL_CRITICAL |
//       GEN_OFFLINE | GEN_FAILURE | GEN_OVERHEAT |
//       BATT_LOW_VOLTAGE | BATT_FAILURE | COMM_LOSS
// severity: L1 | L2 | L3   (L3 most severe)
// status: OPEN | ACKNOWLEDGED | RESOLVED | ESCALATED
model Alarm {
  id            String   @id @default(cuid())
  tenantId      String
  siteId        String
  type          AlarmType
  severity      AlarmSeverity   @default(L1)
  status        AlarmStatus   @default(OPEN)
  escalationLevel Int    @default(1)
  entityKind    String?
  entityId      String?
  message       String
  value         Float?
  threshold     Float?
  createdAt     DateTime @default(now())
  acknowledgedAt DateTime?
  acknowledgedById String?
  resolvedAt    DateTime?
  resolvedById  String?
  resolution    String?

  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  // Phase 1: added the FK that was missing on tenantId (see Region).
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  acknowledgedBy User?   @relation("AlarmAckedBy", fields: [acknowledgedById], references: [id])
  resolvedBy   User?     @relation("AlarmResolvedBy", fields: [resolvedById], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([siteId, status])
  @@index([status, severity])
  @@index([createdAt])
  @@index([acknowledgedById])
  @@index([resolvedById])
}

model SiteEvent {
  id        String   @id @default(cuid())
  siteId    String
  tenantId  String   // Phase 1 step 2-5: denormalised from Site.
  kind      String   // INFO | WARN | CRITICAL | CONTROL | DELIVERY
  message   String
  meta      String?  // JSON
  createdAt DateTime @default(now())

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([siteId, createdAt])
}

// ──────────────────────────────────────────────────────────────────────────
// Inventory, deliveries, control, maintenance, audit, notifications
// ──────────────────────────────────────────────────────────────────────────

// status: SCHEDULED | IN_TRANSIT | DELIVERED | VERIFIED | DISCREPANCY | CANCELLED
model FuelDelivery {
  id          String   @id @default(cuid())
  siteId      String
  tenantId    String   // Phase 1 step 2-5: denormalised from Site.
  tankId      String
  supplier    String
  driverName  String?
  vehiclePlate String?
  volumeOrderedLitres Decimal @db.Decimal(12, 3)
  volumeDeliveredLitres Decimal? @db.Decimal(12, 3)
  doNumber    String   // delivery order number
  status      FuelDeliveryStatus   @default(SCHEDULED)
  scheduledAt DateTime
  dispatchedAt DateTime?
  deliveredAt DateTime?
  verifiedAt  DateTime?
  discrepancyNote String?
  unitPrice   Decimal    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tank FuelTank @relation(fields: [tankId], references: [id])

  @@index([tenantId])
  @@index([tenantId, siteId])
  @@index([siteId, status])
  @@index([scheduledAt])
}

// command: START | STOP | EMERGENCY_STOP | RESET
//
// status — WHAT IS ACTUALLY WRITTEN (corrected, Phase 5). The previous
// comment here claimed:
//
//     status: PENDING | SENT | EXECUTED | FAILED | TIMEOUT
//
// EXECUTED and TIMEOUT are NEVER WRITTEN anywhere in the codebase
// (`grep -rn '"EXECUTED"' src/` returns zero hits). The enum still declares
// them, so this comment described an aspiration rather than behaviour, and an
// auditor reading it would conclude a command lifecycle was verified when
// nothing observes an outcome. The enum members are left in place because
// removing them is a destructive schema change and they remain the correct
// target states for a future real dispatcher.
//
//   SENT    the command was accepted and its SIMULATED dispatch was applied to
//           in-process state. No hardware is signalled; there is no Modbus,
//           MQTT or serial write anywhere in the control path.
//   FAILED  refused by a safety interlock, or the write itself failed.
//
// There is no transition out of SENT. `executedAt` is populated at ISSUE time
// and `result` is set to "OK" before anything could have happened, so neither
// field is evidence of execution — read `status` and this comment instead.
model ControlCommand {
  id          String   @id @default(cuid())
  generatorId String
  // Phase 1 step 2-5. ControlCommand is the one table with no `siteId` of its
  // own, so it backfills via generatorId -> Generator.tenantId (two hops).
  // Adding a siteId column was considered and rejected: it would denormalise a
  // relationship the schema already expresses, and the table has no rows.
  tenantId    String
  command     GenCommandType
  status      ControlCommandStatus   @default(PENDING)
  reason      String?
  issuedById  String?
  issuedAt    DateTime @default(now())
  executedAt  DateTime?
  result      String?

  // Phase 5 idempotency. NULLABLE with no default, so every pre-existing row
  // and every command from a client that sends no key is honestly NULL.
  //
  // The key lives on the command row rather than in a separate IdempotencyRecord
  // table for one reason: a replay must return the ORIGINAL outcome, and that
  // outcome is this row. A side table would mean joining back to find which
  // command the key produced, duplicating tenant/actor columns, and
  // reconstructing the result instead of reading it.
  idempotencyKey String?
  /**
   * Short digest of the request payload for this key.
   *
   * Lets a replay with the SAME key but a DIFFERENT payload be rejected rather
   * than silently answered with the first outcome — which would be a client bug
   * (reusing a key for a different command) disguised as a successful retry.
   * A digest rather than the raw body so the column does not become a store of
   * arbitrary client input, and so it is fixed-width.
   */
  payloadFingerprint String?

  generator Generator @relation(fields: [generatorId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  issuedBy  User?     @relation(fields: [issuedById], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([generatorId, status])
  // Scoped to (tenant, generator) so one tenant's key cannot collide with
  // another's, and a key cannot be reused across two different generators.
  //
  // NULLs are ignored by a Postgres unique index, which is load-bearing: every
  // existing client that sends no Idempotency-Key has idempotencyKey = NULL, and
  // those rows must NOT be treated as duplicates of each other. A unique index
  // that treated NULLs as equal would make every un-keyed command a duplicate of
  // the first one ever issued.
  @@unique([tenantId, generatorId, idempotencyKey])
}

/// Phase 2 — safety interlock override audit trail.
///
/// Every interlock DENIAL is recorded, and every two-person OVERRIDE is
/// recorded here with both actors. The two-person rule is only meaningful if
/// the second authorization is separately attributable: an override that just
/// says "approved" cannot be reviewed afterwards to establish who carried the
/// risk.
///
/// Deliberately append-only in practice — it answers "who bypassed a safety
/// interlock, who countersigned it, and why", which is a compliance question
/// long after the fact.
model InterlockOverride {
  id          String   @id @default(cuid())
  tenantId    String
  generatorId String
  /// The command that was refused, and is being overridden.
  command     GenCommandType
  /// InterlockRuleId that produced the refusal.
  ruleId      String
  /// Operator who requested the override.
  requestedById String
  /// Second, higher-authority operator who authorised it. Null when the
  /// override did NOT require two people — kept nullable so a single-tier
  /// override is recorded by the same code path.
  approvedById  String?
  /// Operator's stated justification. Recorded verbatim; overrides without a
  /// reason are how safety controls get normalised away.
  justification String
  createdAt   DateTime @default(now())

  generator   Generator @relation(fields: [generatorId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  requestedBy User      @relation("InterlockOverrideRequested", fields: [requestedById], references: [id])
  approvedBy  User?     @relation("InterlockOverrideApproved", fields: [approvedById], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([generatorId])
}

// type: PREVENTIVE | CORRECTIVE | OIL_CHANGE | INSPECTION | CALIBRATION
// status: OPEN | SCHEDULED | IN_PROGRESS | DONE | CANCELLED
// priority: P1 | P2 | P3 | P4
model MaintenanceTicket {
  id          String   @id @default(cuid())
  siteId      String
  tenantId    String   // Phase 1 step 2-5: denormalised from Site.
  assetKind   String   // GENERATOR | TANK | BATTERY | IOT
  assetId     String
  type        String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority   @default(P3)
  title       String
  description String?
  assignedToId String?
  scheduledFor DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site       Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignedTo User?  @relation("TicketAssignee", fields: [assignedToId], references: [id])

  @@index([tenantId])
  @@index([tenantId, siteId])
  @@index([siteId, status])
  @@index([status, priority])
}

// action: CREATE | UPDATE | DELETE | CONTROL | ACK | RESOLVE | LOGIN | EXPORT | CONFIG
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  entity     String
  entityId   String?
  details    String   // JSON string
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
  // Phase 1: added the FK that was missing on tenantId (see Region).
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@index([userId])
}

// channel: SMS | EMAIL | PUSH | WHATSAPP
// status: QUEUED | SENT | DELIVERED | FAILED
model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  channel   NotificationChannel
  recipient String
  subject   String
  body      String
  alarmId   String?
  status    NotificationStatus   @default(QUEUED)
  attempts  Int      @default(0)
  sentAt    DateTime?
  createdAt DateTime @default(now())

  // Phase 1: added the FK that was missing on tenantId (see Region).
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────────────────
// Alarm Suppression / Maintenance Windows (Task 32-B)
// ──────────────────────────────────────────────────────────────────────────
// Time-bound rule that prevents specific alarm types from firing during
// planned maintenance windows. Used by the alarm engine (raiseAlarm) and
// the suppression-check helper to short-circuit alarm creation when an
// active suppression matches.
//
// Semantics:
//   - siteId IS NULL  → applies to ALL sites (tenant-wide).
//   - alarmType IS NULL → applies to ALL alarm types for the site(s).
//   - isActive = false → rule cancelled (manual or auto after expiry).
//   - The matching logic in src/lib/fgmp/suppression-check.ts treats a
//     rule as "currently suppressing" when isActive=true AND now is
//     between startsAt and endsAt. Expired-but-active rows are ignored
//     by the matcher but kept in the DB for the audit history.
model AlarmSuppression {
  id         String   @id @default(cuid())
  tenantId   String
  siteId     String?  // null = all sites (tenant-wide)
  alarmType  String?  // null = all alarm types (e.g. "FUEL_LOW", "GEN_FAULT")
  reason     String   // human-readable reason for suppression
  createdBy  String
  startsAt   DateTime
  endsAt     DateTime
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  site   Site?  @relation(fields: [siteId], references: [id])
  user   User   @relation(fields: [createdBy], references: [id])

  @@index([tenantId, isActive, endsAt])
  @@index([siteId])
}

// ──────────────────────────────────────────────────────────────────────────
// Per-User Notification Preferences (Task 33-A)
// ──────────────────────────────────────────────────────────────────────────
// Lets each operator customize which alarm notifications they receive, by
// severity and channel (in-app / email / SMS), plus optional quiet hours
// during which in-app notifications are silenced (L3 critical alarms still
// trigger audible alerts). One row per user (1:1).
//
// Semantics:
//   - inAppSeverities / emailSeverities / smsSeverities are comma-separated
//     subsets of {L1,L2,L3} (e.g. "L1,L2,L3"). The notification dispatcher
//     filters a queued alarm by intersecting its severity with the list of
//     the channel the user has enabled.
//   - quietHoursStart / quietHoursEnd are integers 0-23 (AST timezone).
//     When both are null, quiet hours are disabled. When start > end the
//     window wraps past midnight (e.g. 22 → 6 = 10pm → 6am).
//   - emailOverride / phoneOverride are optional contact overrides. When
//     null/empty the dispatcher falls back to user.email / user.phone.
model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  // Tier A (Phase 1 step 2-5): resolved through User.tenantId, not a parent
  // Site — an operator's preferences exist independently of any site.
  tenantId     String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Channels — which delivery methods the user wants
  inAppEnabled  Boolean  @default(true)
  emailEnabled  Boolean  @default(false)
  smsEnabled    Boolean  @default(false)
  // Severity filters — which severities trigger notifications per channel
  inAppSeverities  String  @default("L1,L2,L3")  // comma-separated
  emailSeverities  String  @default("L2,L3")
  smsSeverities    String  @default("L3")
  // Quiet hours — suppress in-app + sound during these hours (24h format, AST timezone)
  quietHoursStart  Int?    // 0-23 (e.g. 22 for 10pm)
  quietHoursEnd    Int?    // 0-23 (e.g. 6 for 6am)
  // Email/SMS contact overrides (optional — defaults to user.email)
  emailOverride    String?
  phoneOverride    String?
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

// ──────────────────────────────────────────────────────────────────────────
// API Keys (Task 35-E) — programmatic access to the FGMP REST API
// ──────────────────────────────────────────────────────────────────────────
// Each key has a SHA-256 hash of the raw secret (only shown once at creation),
// a set of scopes (comma-separated: read,write,control,admin), optional
// IP allowlist, and an expiry. Revoked keys stay in the table for audit.
//
// scopes: comma-separated subset of {read,write,control,admin}
model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  keyPrefix   String    // first 8 chars of the raw key, for identification
  keyHash     String    @unique // SHA-256 hash of the full raw key
  scopes      String    @default("read") // comma-separated
  ipAllowlist String?   // comma-separated CIDRs, null = any IP
  createdBy   String    // user id
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  // Phase 1: added the FK that was missing on tenantId (see Region).
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, revoked])
  @@index([keyHash])
}

// ──────────────────────────────────────────────────────────────────────────
// Shift Handover Log (Round 46) — NOC operator shift handover notes
// ──────────────────────────────────────────────────────────────────────────
// Each NOC is a 24/7 operation: operators rotate across shifts (Morning,
// Evening, Night) and the outgoing operator leaves a structured handover
// note for the incoming operator. This model stores those notes.
//
// Semantics:
//   - shift: MORNING | EVENING | NIGHT  (the shift that PRODUCED the note)
//   - status: OPEN | ACKNOWLEDGED  (OPEN = awaiting the incoming operator
//     to read; ACKNOWLEDGED = incoming operator has confirmed receipt)
//   - openAlarmsCount / criticalSitesCount are point-in-time snapshots the
//     outgoing operator stamps onto the note (so the incoming operator sees
//     the state of the network at handover time without re-deriving it).
//   - priority: P1 | P2 | P3  (operator-set urgency of the handover note)
//   - tenantId: tenant isolation (every operator only sees their tenant's
//     handover log).
//   - createdAt = handover note creation time; acknowledgedAt = when the
//     incoming operator confirmed receipt.
model ShiftHandover {
  id                 String   @id @default(cuid())
  tenantId           String
  authorId           String   // outgoing operator (User.id)
  authorName         String   // denormalized for fast list rendering
  authorRole         String   // denormalized role at handover time
  shift              String   // MORNING | EVENING | NIGHT
  status             String   @default("OPEN")  // OPEN | ACKNOWLEDGED
  priority           String   @default("P3")    // P1 | P2 | P3
  // Outgoing operator's free-form handover notes (required).
  notes              String
  // Optional: ongoing issues the incoming operator should watch.
  ongoingIssues      String?
  // Optional: site ids the outgoing operator flagged for attention.
  flaggedSiteIds     String?  // comma-separated site ids
  // Point-in-time snapshot of the network at handover.
  openAlarmsCount    Int      @default(0)
  criticalSitesCount Int      @default(0)
  avgFuelPct         Float    @default(0)
  // Acknowledgement (incoming operator confirms receipt).
  acknowledgedById   String?
  acknowledgedAt     DateTime?
  acknowledgedNote   String?  // optional reply from the incoming operator
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Phase 1: added the FK that was missing on tenantId (see Region).
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([shift, status])
}

// ──────────────────────────────────────────────────────────────────────────
// System Settings (Task 35-E) — global platform configuration key-value store
// ──────────────────────────────────────────────────────────────────────────
// Simple key-value table for global settings (alarm thresholds, escalation
// timers, branding colors, etc.). Each row is one setting; the UI groups them
// by category. Values are stored as strings; the API coerces to the right type.
//
// category: ALARM | ESCALATION | BRANDING | PLATFORM | FORECAST
model SystemSetting {
  id        String   @id @default(cuid())
  category  SystemSettingCategory
  key       String   @unique
  value     String
  type      String   @default("string") // string | number | boolean | json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category])
}

// ──────────────────────────────────────────────────────────────────────────
// Site Gateways (Task 48) — ESP32/ESP8266 edge gateways
// ──────────────────────────────────────────────────────────────────────────
// A SiteGateway is the ESP32/ESP8266 board that aggregates RS485 traffic
// from one or more fuel dispensers at a site and bridges it to the FGMP
// platform over WiFi/Ethernet. Each gateway reports live health telemetry
// (uptime, CPU temp, heap, WiFi RSSI) every tick.
//
// status: ONLINE | OFFLINE | DEGRADED
model SiteGateway {
  id          String   @id @default(cuid())
  siteId      String
  tenantId    String   // Phase 1 step 2-5: denormalised from Site.
  hostname    String
  // Optional hardware identity, editable via PATCH /api/fgmp/edge/gateways/[id].
  model       String?
  ipAddress   String?
  status      GatewayStatus   @default(ONLINE)  // ONLINE | OFFLINE | DEGRADED
  uptimeSec   Int      @default(0)
  cpuTempC    Float    @default(45)
  heapKb      Int      @default(0)
  wifiRssi    Int      @default(-65)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, siteId])
  @@index([siteId])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────────────────
// ESP Firmware Releases & Deployments (Task 48) — OTA management
// ──────────────────────────────────────────────────────────────────────────
// An EspFirmwareRelease is a versioned firmware image for the ESP32/ESP8266
// controllers on fuel dispensers. Each release tracks its checksum, size,
// channel (stable | beta | hotfix) and release notes; deployments are
// recorded as EspFirmwareDeployment rows that reference a dispenser + a
// release + the initiating user.
//
// channel: stable | beta | hotfix
model EspFirmwareRelease {
  id           String   @id @default(cuid())
  version      String   @unique
  channel      String   @default("stable")  // stable | beta | hotfix
  checksum     String
  sizeKb       Int
  releaseNotes String   @default("")
  releasedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  deployments EspFirmwareDeployment[]

  @@index([channel])
  @@index([releasedAt])
}

// status: QUEUED | DOWNLOADING | FLASHING | SUCCESS | FAILED | ROLLED_BACK
model EspFirmwareDeployment {
  id            String   @id @default(cuid())
  dispenserId   String
  // Tier A (Phase 1 step 2-5): resolved through FuelDispenser.tenantId. A
  // deployment is the tenant-scoped instance of a global EspFirmwareRelease.
  tenantId      String
  releaseId     String
  status        OtaStatus   @default(QUEUED)
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  initiatedById String?

  dispenser   FuelDispenser      @relation(fields: [dispenserId], references: [id], onDelete: Cascade)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  release     EspFirmwareRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  initiatedBy User?              @relation(fields: [initiatedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, dispenserId])
  @@index([dispenserId])
  @@index([status])
  @@index([startedAt])
}

// ──────────────────────────────────────────────────────────────────────────
// Backup Records (Task 48) — SQLite snapshot audit trail
// ──────────────────────────────────────────────────────────────────────────
// Each row records one backup snapshot of the live SQLite database file
// (kind = MANUAL | SCHEDULED | PRE_RESTORE) with its SHA-256 hash, size, and
// the user who created/restored it. The actual .db file lives on disk under
// `backups/`; this table is the audit index.
//
// status: COMPLETED | FAILED | RESTORED
// kind:   MANUAL | SCHEDULED | PRE_RESTORE
model BackupRecord {
  id            String   @id @default(cuid())
  tenantId      String
  filename      String
  sizeBytes     Int      @default(0)
  sha256        String?
  kind          String   @default("MANUAL")
  status        String   @default("COMPLETED")
  note          String?
  createdById   String?
  restoredById  String?
  createdAt     DateTime @default(now())
  restoredAt    DateTime?

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy  User?  @relation("BackupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  restoredBy User?  @relation("BackupRestoredBy", fields: [restoredById], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([status])
}

// ── Phase 2: RS485 / Modbus bus diagnostics ───────────────────────────────
// Persisted rather than derived. The previous implementation reported zeros
// because nothing measured the bus — and a dashboard showing "0 CRC errors" on
// a failing bus is worse than showing nothing, because it looks healthy.
//
// These tables hold what the protocol layer ACTUALLY observed. Every counter is
// incremented at the point the corresponding event happens (see
// src/lib/fgmp/protocol/client.ts); nothing here is synthesised.

/// A physical RS485 segment. Dispensers on one segment share a bus, so bus
/// health is a property of the segment, not of any single dispenser — and two
/// devices configured at the same slave address is a bus-level fault.
model Rs485Bus {
  id            String   @id @default(cuid())
  tenantId      String   // Phase 1: denormalised so RLS can scope the bus.
  label         String
  siteId        String?

  // Bus configuration. These are the values the modem is actually programmed
  // with, and a mismatch between here and a device's own configuration is one
  // of the most common causes of a silent bus.
  baudrate      Int      @default(9600)
  /// Modbus slave address, 1-247. Unique per bus: two devices sharing an
  /// address makes both answers collide and is unrecoverable from software.
  /// Enforced by a unique constraint rather than left to convention.
  unitAddress   Int      @default(1)
  parity        String   @default("8N1")
  stopBits      Int      @default(1)
  dataBits      Int      @default(8)

  online        Boolean  @default(false)
  lastPollAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site          Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  diagnostics   Rs485BusDiagnostic[]

  @@unique([tenantId, unitAddress])
  @@index([tenantId])
  @@index([siteId])
}

/// One row per device per bus: the counters and latencies for that slave.
///
/// Separate from Rs485Bus because bus-level faults (collisions, a shorted
/// trunk) and device-level faults (a dead slave) need different responses, and
/// collapsing them into one table makes the operator's first question — "is the
/// wire broken or is the device dead?" — unanswerable from the data.
model Rs485BusDiagnostic {
  id            String   @id @default(cuid())
  tenantId      String
  busId         String
  /// Modbus slave address, 1-247.
  unitAddress   Int
  /// Prisma model this device is, so a reading can be attributed to an asset.
  deviceKind    String
  deviceId      String

  // Counters since the row was created. Monotonic by design: an operator needs
  // to see that errors are accumulating, and a counter that resets itself is
  // indistinguishable from a bus that is healthy.
  crcErrors         Int      @default(0)
  timeouts          Int      @default(0)
  retries           Int      @default(0)
  retriesExhausted  Int      @default(0)
  exceptionResponses Int     @default(0)
  successfulReads   Int      @default(0)
  failedReads       Int      @default(0)

  lastLatencyMs     Float    @default(0)
  averageLatencyMs  Float?
  lastPollAt        DateTime?
  lastError         String?
  /// ModbusFailureKind: timeout | crc-mismatch | short-frame | address-echo |
  /// function-code | exception-response | illegal-value. Stored as text
  /// because the set is open and a new failure kind must not require a
  /// migration on a live device fleet.
  lastErrorKind     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bus           Rs485Bus             @relation(fields: [busId], references: [id], onDelete: Cascade)
  samples       Rs485LatencySample[]

  @@unique([busId, unitAddress])
  @@index([tenantId])
  @@index([deviceKind, deviceId])
}

/// Rolling samples of per-poll latency.
///
/// Kept as raw samples rather than only aggregates because the SHAPE of the
/// distribution is diagnostic: a bimodal latency on an RS485 segment usually
/// means two devices are fighting for the bus, which an average hides
/// completely. Bounded by the poller so the table cannot grow without limit.
model Rs485LatencySample {
  id            String   @id @default(cuid())
  tenantId      String
  diagnosticId  String
  unitAddress   Int
  latencyMs     Float
  ok            Boolean
  recordedAt    DateTime @default(now())

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  diagnostic    Rs485BusDiagnostic     @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)

  @@index([tenantId, recordedAt])
  @@index([diagnosticId, recordedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 4 — interlock thresholds become DATA, and site protected load is modelled
// ─────────────────────────────────────────────────────────────────────────────
//
// Appended, not edited in place: another agent's watermark change is committed
// above and must not be reformatted or reordered.

// Where a threshold's VALUE came from. This is the whole point of the model:
// an operator must be able to see whether a limit they are relying on came from
// an OEM datasheet or from a guess someone made in 2026.
//
//   INFERRED is the default for everything in this codebase, because nothing in
//   the original specification supplied a safety number. It is not a shame
//   label — it is the honest state of a threshold nobody has yet confirmed.
enum ThresholdSource {
  // Read from the engine/generator OEM datasheet for the installed unit.
  OEM_DATASHEET
  // Defined by the operator for their own fleet (cooldown, restart backoff).
  SITE_POLICY
  // Comes from the tenant's maintenance schedule (service intervals).
  MAINTENANCE_SCHEDULE
  // Derived from the engine's physical parameters rather than a fixed number
  // (e.g. cranking fuel as a fraction of usable tank capacity).
  DERIVED
  // A placeholder. Chosen conservatively so it fails toward REFUSAL, never
  // toward permitting an unsafe action. MUST be confirmed before the threshold
  // is relied upon.
  INFERRED
}

// The unit a threshold is expressed in. Storing the unit explicitly is what
// lets a value be interpreted without reading the code: `500` means something
// completely different as HOURS_OVERDUE than as PERCENT.
enum ThresholdUnit {
  CELSIUS
  KPA
  PERCENT_OF_TANK
  MINUTES
  HOURS
  LITRES_PER_MINUTE
  // Phase 4 — energy domain additions
  MILLIVOLTS
  PERCENT
}

/// A single interlock threshold, stored per tenant with its provenance.
///
/// WHY PERSISTED RATHER THAN A CONSTANT
/// A safety threshold that can only be changed by editing source and shipping a
/// deploy is not operable. Operators must be able to correct a number against
/// their own OEM manual without a release. It also makes the provenance
/// queryable: "which of my limits are still guesses?" becomes a SELECT.
///
/// WHY TENANT-SCOPED
/// Coolant limits and service intervals are fleet-specific: the same engine
/// model in two tenants can have different maintenance schedules, and one
/// tenant may have sourced a real datasheet while another has not.
model InterlockThreshold {
  id        String   @id @default(cuid())
  tenantId  String

  /// Stable key matching the InterlockRuleId the value feeds. E.g.
  /// "coolantMaxC", "crankingFuelFraction". Unknown to this schema on purpose:
  /// a threshold the code does not understand is still worth storing and
  /// surfacing, and rejecting it would block an operator recording a
  /// provisional decision.
  thresholdKey String

  value     Float
  unit      ThresholdUnit
  source    ThresholdSource @default(INFERRED)

  /// WHO confirmed the value, and WHEN. Null source=INFERRED with a null
  /// confirmedBy is the honest "nobody has checked this" state. Populating
  /// confirmedBy without changing `source` is allowed but misleading, so the
  /// API reports that combination rather than hiding it.
  confirmedById String?
  confirmedAt   DateTime?

  /// Free text: the document, manual page, or policy clause the value came
  /// from. Without this, "confirmed" is unfalsifiable.
  sourceRef String?

  /// Optional per-site override. NULL means "use the tenant value". Some sites
  /// legitimately differ (a coastal site, a genset on a restricted schedule),
  /// and a global-only model forces operators to either over-protect everyone
  /// or under-protect one site.
  siteId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  site       Site?   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  confirmedBy User?   @relation("ThresholdConfirmedBy", fields: [confirmedById], references: [id])

  // A threshold key is unique per (tenant, site): one active value for a site,
  // one tenant-wide default when siteId is NULL.
  @@unique([tenantId, thresholdKey, siteId])
  @@index([tenantId])
  @@index([tenantId, siteId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 4 — Solar domain
// ─────────────────────────────────────────────────────────────────────────────
//
// A site can have multiple arrays on different roofs, at different tilts, with
// different inverters. The child-table design is the only way to express that
// without forcing every array on a site to share one rating — which would be
// wrong for the multi-roof case the domain exists to describe.
//
// Telemetry for output kW, daily yield kWh and irradiance follows the EXISTING
// sensor/telemetry pattern (IotDevice + SensorReading) rather than inventing a
// parallel one. These models hold the static inventory; the live readings come
// from the same ingestion pipeline that already handles fuel sensors and
// battery sensors.

/// A site's solar installation. One per site (1:1 with Site), holding the
/// aggregated capacity and any site-level notes.
model SolarSite {
  id          String   @id @default(cuid())
  siteId      String   @unique
  tenantId    String
  capacityKwp Float
  installedAt DateTime @default(now())
  notes       String?

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  arrays SolarArray[]

  @@index([tenantId])
}

/// One array within a SolarSite. Each array has its own inverter and
/// orientation, so a site with panels on two roofs at different tilts gets two
/// rows — which is exactly the case a single Site field could not describe.
model SolarArray {
  id             String  @id @default(cuid())
  solarSiteId    String
  tenantId       String
  label          String
  ratedKwp       Float
  orientation    String?  // e.g. "S", "SW", "flat"
  tiltDegrees    Int?
  azimuthDegrees Int?
  inverterSerial String?
  inverterModel  String?
  installedAt    DateTime @default(now())

  solarSite SolarSite @relation(fields: [solarSiteId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([solarSiteId])
}

// ── MFA (Phase 5) ───────────────────────────────────────────────────────────
// A TOTP secret is a BEARER credential for the second factor: anyone who reads
// it can generate valid codes forever. So `secretEnc` stores the AES-256-GCM
// envelope from src/lib/fgmp/mfa/crypto.ts, never plaintext. A plaintext column
// would not be "MFA with a weakness" — it would be MFA with the second factor
// removed, while still appearing enabled.
//
// Encryption is worthless without the key, and the key lives in
// FGMP_MFA_ENCRYPTION_KEY (outside the database). Enrolment refuses to run
// without it, which is how "never let a half-configured MFA lock anyone out" is
// enforced in code rather than in a runbook.

/// Per-user MFA enrolment. One row per user who has enrolled.
model MfaEnrollment {
  id            String   @id @default(cuid())
  /// The user's own tenant. This is a per-user CREDENTIAL, so a cross-tenant
  /// read is a credential leak rather than a data leak — it is protected with
  /// FORCE RLS for that reason.
  tenantId      String
  userId        String   @unique

  /// AES-256-GCM envelope: v1.<iv>.<authTag>.<ciphertext>. Never plaintext.
  secretEnc     String
  /// Envelope version, so a future scheme can be rolled out and a value written
  /// by a newer scheme fails LOUDLY instead of decrypting to nonsense.
  keyVersion    Int      @default(1)
  /// Whether the factor is currently required at login. Separate from the row's
  /// existence so MFA can be temporarily suspended by a break-glass reset
  /// without destroying the enrolment record and its audit trail.
  enabled       Boolean  @default(false)
  /// Totp digits and period are stored rather than assumed, so a change of
  /// policy later cannot silently invalidate every enrolled user.
  digits        Int      @default(6)
  periodSeconds Int      @default(30)

  enrolledAt    DateTime  @default(now())
  /// Null while disabled: the last moment the factor was actually in force.
  lastUsedAt    DateTime?
  /// Set by a break-glass reset. Forces re-enrolment before MFA is required
  /// again, so a reset cannot quietly leave the account unprotected.
  disabledAt    DateTime?
  disabledReason String?

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  backupCodes   MfaBackupCode[]
  resets        MfaResetRequest[]
  challenges    MfaChallenge[]

  @@index([tenantId])
}

/// Single-use backup codes, hashed.
///
/// Separate rows rather than a hashed blob on the enrolment, because single-use
/// must be enforced BY THE DATABASE: an `usedAt` column cleared in application
/// code is bypassable by two concurrent requests both reading "unused".
model MfaBackupCode {
  id            String   @id @default(cuid())
  tenantId      String
  enrollmentId  String
  /// Ordinal, so an operator can be told "you have 4 codes left" and a
  /// particular code identified without exposing any hash.
  slot          Int
  /// bcrypt. Backup codes come from a CSPRNG rather than a word list, so this
  /// cost buys nothing against guessing — it buys key-material unification: one
  /// hash function governs every credential in the system.
  codeHash      String
  /// NULL until consumed. Consumption is a conditional UPDATE, so a replay
  /// affects zero rows rather than succeeding.
  usedAt        DateTime?
  /// When it was used, and against which challenge — so an operator can tell
  /// their own reuse from someone else's.
  usedByChallengeId String?
  createdAt     DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment    MfaEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, slot])
  @@index([tenantId])
}

/// The pending second factor, between "password accepted" and "session issued".
///
/// NextAuth's Credentials authorize() returns a user or null, so the second
/// factor cannot live inside it. This row is the boundary: authorize() succeeds,
/// the client is handed a CHALLENGE TOKEN, and no session exists until
/// /api/fgmp/mfa/challenge consumes this row and issues one.
model MfaChallenge {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String
  enrollmentId  String

  /// SHA-256 of the token. Only the hash is stored, so a read of this table does
  /// not hand over live challenge tokens.
  tokenHash     String   @unique
  /// Short: 5 minutes. A challenge authorises exactly one transition and the
  /// operator is standing at the login screen with the code in hand.
  expiresAt     DateTime
  /// Consumed by a conditional UPDATE (`usedAt IS NULL`), so two concurrent
  /// verifications cannot both complete.
  usedAt        DateTime?
  /// One failed attempt invalidates the challenge, bounding guessing to a
  /// single try per issued token.
  attempts      Int      @default(0)
  failedAt      DateTime?

  createdAt     DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment    MfaEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([expiresAt])
}

/// A two-person request to clear someone's MFA.
///
/// Modelled on InterlockOverride, which already requires requestedById +
/// approvedById + a justification for a safety bypass. A single-operator reset
/// is exactly the social-engineering attack ("I'm the superadmin and it's
/// urgent"); a second countersignature turns a convincing conversation into a
/// logged, attributable request.
model MfaResetRequest {
  id            String   @id @default(cuid())
  tenantId      String
  /// The account whose factor is being cleared.
  userId        String
  enrollmentId  String

  requestedById String
  /// NULL until a SECOND, different operator approves. Enforced in the service
  /// layer and again by the approval query.
  approvedById  String?
  /// Mandatory. A reset with no stated reason is not actionable later.
  justification String

  status        MfaResetStatus @default(PENDING)
  createdAt     DateTime  @default(now())
  approvedAt    DateTime?
  appliedAt     DateTime?
  /// Recorded after the fact so an auditor can see that a reset happened, by
  /// whom, and whether MFA was subsequently re-established.
  outcomeNote   String?

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment    MfaEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user          User          @relation("MfaResetTarget", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy   User          @relation("MfaResetRequested", fields: [requestedById], references: [id])
  approvedBy    User?         @relation("MfaResetApproved", fields: [approvedById], references: [id])

  @@index([tenantId, status])
  @@index([userId])
}

enum MfaResetStatus {
  PENDING
  APPROVED
  APPLIED
  REJECTED
}

// ──────────────────────────────────────────────────────────────────────────
// Platform administration (super-admin support access)
//
// WHY THESE TWO MODELS HAVE NO `tenantId` AND NO RLS
// --------------------------------------------------
// They are platform-global by definition. `SupportSession` records which
// operator is allowed to act inside which tenant; a row scoped to a tenant
// could not grant access to that tenant. `PlatformAuditLog` records what the
// operator did, and must stay readable after the tenant it concerned is
// deleted — so it deliberately has no foreign keys to Tenant or User.
//
// Isolation for these tables is therefore the API layer (every route under
// /api/fgmp/platform requires SUPERADMIN) plus a test that enumerates the
// routes that touch them. Compare `Tenant` and `SystemSetting`, the other two
// global tables in this schema, which are treated the same way.
//
// The tenant-VISIBLE half of the trail is not here: starting a support session
// also writes a normal `AuditLog` row inside the target tenant, so the tenant
// sees who looked, in its own audit view.
// ──────────────────────────────────────────────────────────────────────────

model SupportSession {
  id           String    @id @default(cuid())
  /// The operator. Deliberately not a relation: the record must survive the
  /// operator being deleted, and it is read without a tenant context.
  actorUserId  String
  actorEmail   String
  /// The single tenant this session may act as. One session, one tenant —
  /// there is no "all tenants" value, on purpose.
  tenantId     String
  /// Free text, required. Enforced non-empty by the route, not by a default.
  reason       String
  /// Ticket / case reference, when the support process requires one.
  ticketRef    String?
  /// "READ" or "WRITE". READ is the default; see support-session.ts for why
  /// write mode is a separate grant rather than a flag on the same one.
  mode         String    @default("READ")
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  endedAt      DateTime?
  endReason    String?
  ip           String?
  userAgent    String?

  @@index([actorUserId, endedAt])
  @@index([tenantId, createdAt])
}

model PlatformAuditLog {
  id               String   @id @default(cuid())
  actorUserId      String
  actorEmail       String
  action           String
  targetTenantId   String?
  supportSessionId String?
  /// JSON string. Kept as text for the same reason AuditLog.details is: the
  /// shape varies by action and a column per action would be unusable.
  detail           String
  ip               String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetTenantId, createdAt])
}
