// FGMP — Fuel & Generator Monitoring Platform
// Prisma schema (PostgreSQL).
//
// Phase 1 step 1 migrated this from SQLite to PostgreSQL. Two consequences
// worth stating explicitly, because the SQLite version made both impossible:
//
//   * Enums can now be native `enum` types. The SQLite build stored every
//     discriminator as a free `String` with the legal values documented only in
//     a comment — nothing but application code prevented an invalid value from
//     reaching the database. Native enums land in step 8.
//   * RLS (step 6) is only meaningful on PostgreSQL. On SQLite there was no
//     database-enforced tenant boundary at all: isolation was entirely
//     application-level, so a single missed `assertTenantOwned` was a
//     cross-tenant data breach — exactly the Phase 0 geography IDOR.
//
// Remaining migration steps: nullable tenant_id (2), backfill (3), NOT NULL +
// FK (4), tenant_id-leading indexes (5), RLS (6), per-request context (7),
// native enums (8), Float -> Decimal (9), TimescaleDB hypertables (10), RLS
// regression suite (11).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────
// Native enums (Phase 1 step 8)
// ──────────────────────────────────────────────────────────────────────────
// Phase 1 step 1 moved the datasource to PostgreSQL, which makes native enum
// types possible for the first time. Under SQLite every discriminator below was
// a free `String` whose legal values existed only in a comment — nothing but
// application code prevented an invalid value reaching the database.
//
// IMPORTANT — these value lists were reconciled against the actual runtime
// writers, NOT copied from the documentation comments above each model. Four
// documented lists were incomplete, and a native enum built from them alone
// would have rejected values the application legitimately writes:
//
//   * User.role               — the comment omitted SUPERADMIN (types.ts `Role`).
//   * Notification.channel    — the comment listed none; engine.ts writes SMS,
//                               EMAIL and WHATSAPP.
//   * MaintenanceTicket.status — writers produce SCHEDULED / IN_PROGRESS /
//                               DONE / CANCELLED.
//   * FuelDelivery.status     — DISCREPANCY is declared but never written
//                               (kept: a legitimate terminal state).
//
// Deliberately NOT enum-ised — open/extensible or write-once audit values where
// a native enum adds write-time rejection with no integrity benefit:
// AlarmSuppression.status/priority, SiteEvent.kind, AuditLog.action,
// ApiKey.scopes, SystemSetting.type, and BackupRecord.kind/status (the latter
// also orphaned after Phase 0 deleted the backup API).
//
// MaintenanceTicket.type/.assetKind and IotDevice.type stay String: the ticket
// pair is constrained by zod at the API boundary (schemas.ts), and IotDevice.type
// has no documented closed set.

// SUPERADMIN is the platform cross-tenant owner, enforced server-side in
// rbac.ts / auth-helpers.ts. The old `role` comment above model User omitted it.
enum Role {
  SUPERADMIN
  ADMIN
  NOC_OPERATOR
  REGIONAL_MANAGER
  FIELD_ENGINEER
  EXECUTIVE
  READONLY
}

enum SiteStatus {
  ONLINE
  DEGRADED
  OFFLINE
  MAINTENANCE
}

enum Criticality {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum PowerSource {
  GRID
  GENERATOR
  HYBRID
}

enum TankStatus {
  OPERATIONAL
  EMPTY
  MAINTENANCE
  CALIBRATING
}

enum FuelType {
  DIESEL
  PETROL
  // BIOFUEL was missing from the first cut of this enum: it was built from the
  // FuelDispenser doc comment (schema.prisma:608, "DIESEL | PETROL") and
  // missed the FuelTank one (":456", "DIESEL | PETROL | BIOFUEL"). Four API
  // routes validate input against ["DIESEL","PETROL","BIOFUEL"], so the enum
  // would have rejected a value the API accepts. Adding an enum value is
  // strictly safer than dropping one: it cannot break an existing writer,
  // whereas removing BIOFUEL would reject requests users can already make.
  BIOFUEL
}

enum GenStatus {
  RUNNING
  STOPPED
  FAULT
  MAINTENANCE
  OFFLINE
}

enum GenMode {
  AUTO
  MANUAL
  REMOTE
}

enum GenCommandType {
  START
  STOP
  EMERGENCY_STOP
  RESET
}

enum BatteryStatus {
  OK
  LOW
  FAILING
  REPLACEMENT_DUE
  OFFLINE
}

enum EntityKind {
  TANK
  GENERATOR
  BATTERY
  SITE
  DISPENSER
}

enum IotProtocol {
  RS485
  MODBUS_RTU
  MODBUS_TCP
  MQTT
  HTTP
  SNMP
}

enum IotStatus {
  ONLINE
  OFFLINE
  DEGRADED
  PROVISIONING
}

enum DispenserStatus {
  IDLE
  AUTHORIZED
  DISPENSING
  STOPPED
  FAULT
  MAINTENANCE
  OFFLINE
}

enum FuelTransactionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED
}

enum AlarmType {
  FUEL_THEFT
  FUEL_REFILL
  FUEL_LOW
  FUEL_CRITICAL
  GEN_OFFLINE
  GEN_FAILURE
  GEN_OVERHEAT
  BATT_LOW_VOLTAGE
  BATT_FAILURE
  COMM_LOSS
  DISPENSER_FAULT
}

enum AlarmSeverity {
  L1
  L2
  L3
}

enum AlarmStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  ESCALATED
}

enum FuelDeliveryStatus {
  SCHEDULED
  IN_TRANSIT
  DELIVERED
  VERIFIED
  DISCREPANCY
  CANCELLED
}

enum ControlCommandStatus {
  PENDING
  SENT
  EXECUTED
  FAILED
  TIMEOUT
}

enum TicketPriority {
  P1
  P2
  P3
  P4
}

enum TicketStatus {
  OPEN
  SCHEDULED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum SystemSettingCategory {
  ALARM
  ESCALATION
  BRANDING
  PLATFORM
  FORECAST
}

enum GatewayStatus {
  ONLINE
  OFFLINE
  DEGRADED
}

enum OtaStatus {
  // QUEUED is the real initial state: engine.ts creates every
  // EspFirmwareDeployment with status "QUEUED" (5 sites), and it is the
  // value documented on EspFirmwareDeployment.status. It was missing from
  // the enum, which made the default unresolvable.
  QUEUED
  IDLE
  PENDING
  DOWNLOADING
  FLASHING
  SUCCESS
  FAILED
  ROLLED_BACK
}

// ──────────────────────────────────────────────────────────────────────────
// Phase 2 — server-side alarm correlation (vertical 4)
// ──────────────────────────────────────────────────────────────────────────

/// Geographic scope a correlation rule groups alarms by.
enum RuleScope {
  SITE
  REGION
  GOVERNORATE
  NATIONAL
}

/// The alarm type a rule counts.
///
/// `ANY` is a real enum member rather than a TypeScript-only sentinel so the
/// database can store it and the RLS/CHECK constraints apply to it. It cannot
/// collide with a genuine alarm type because it is not a member of AlarmType.
enum RuleAlarmType {
  ANY
  FUEL_THEFT
  FUEL_REFILL
  FUEL_LOW
  FUEL_CRITICAL
  GEN_OFFLINE
  GEN_FAILURE
  GEN_OVERHEAT
  BATT_LOW_VOLTAGE
  BATT_FAILURE
  COMM_LOSS
  DISPENSER_FAULT
}

/// Outcome of evaluating one rule against the event stream.
enum RuleEvaluationOutcome {
  /// Threshold not reached, or the rule is disabled.
  NOT_TRIGGERED
  /// Threshold reached; the correlated alarm group was suppressed.
  SUPPRESSED
}

model CorrelationRule {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  description String        @default("")
  enabled     Boolean       @default(true)
  /// ANY counts alarms of every type.
  alarmType   RuleAlarmType
  /// How many matching alarms inside the window are required.
  threshold   Int           @default(1)
  /// Rolling window length in minutes, ending at evaluation time.
  windowMinutes Int         @default(5)
  scope       RuleScope     @default(SITE)
  /// Severity assigned to the correlated group when the rule fires.
  escalateTo  AlarmSeverity @default(L2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  matches CorrelationMatch[]

  @@index([tenantId, enabled])
  @@index([tenantId, updatedAt])
}

/// One rule firing against one geographic bucket at one evaluation time.
///
/// This table is the idempotency ledger, and the UNIQUE constraint is what
/// makes re-evaluation safe: the same rule firing against the same scope
/// bucket for the same set of member alarms can be INSERTed exactly once.
/// Re-running evaluation over an unchanged event stream produces a constraint
/// violation that is caught and treated as "already applied" — not a duplicate
/// suppression.
model CorrelationMatch {
  id        String              @id @default(cuid())
  tenantId  String
  ruleId    String
  /// Geographic bucket key: site id, region id, governorate id, or "__ALL__".
  /// Persisted rather than a label so the UNIQUE constraint is on stable data.
  scopeKey  String
  scope     RuleScope
  /// Human-readable label for display (e.g. "Region: Central Highlands").
  scopeLabel String
  outcome   RuleEvaluationOutcome
  escalateTo AlarmSeverity
  /// How many alarms satisfied the threshold.
  matchCount Int
  /// Sorted member alarm ids, joined with ",".
  ///
  /// This is the second half of the idempotency key and is what distinguishes
  /// "the same event set again" (duplicate — ignored) from "the same bucket
  /// gained another alarm" (a genuinely new match — recorded).
  alarmIds  String
  /// The instant the rule was evaluated, so the match is auditable.
  evaluatedAt DateTime          @default(now())
  createdAt   DateTime          @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rule   CorrelationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, scopeKey, alarmIds])
  @@index([tenantId, evaluatedAt])
  @@index([tenantId, scope])
}

// ──────────────────────────────────────────────────────────────────────────
// Identity & Multi-tenancy
// ──────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  sites         Site[]
  suppressions  AlarmSuppression[]
  // Task 48 — tenant-scoped backup history (MANUAL / AUTOMATIC / PRE_RESTORE).
  backupRecords BackupRecord[]
  // Phase 1 steps 2-5: every tenant-owned table carries a `tenantId` FK so the
  // RLS backstop (step 6) rests on a real constraint. These reverse relations
  // exist only to give Prisma a referential path to `Tenant`.
  regions                  Region[]
  alarms                   Alarm[]
  auditLogs                AuditLog[]
  notifications            Notification[]
  apiKeys                  ApiKey[]
  shiftHandovers           ShiftHandover[]
  tanks                    FuelTank[]
  generators               Generator[]
  batteries                BatteryBank[]
  iotDevices               IotDevice[]
  dispensers               FuelDispenser[]
  fuelTransactions         FuelTransaction[]
  sensorReadings           SensorReading[]
  siteEvents               SiteEvent[]
  fuelDeliveries           FuelDelivery[]
  controlCommands          ControlCommand[]
  interlockOverrides      InterlockOverride[]
  maintenanceTickets       MaintenanceTicket[]
  siteGateways             SiteGateway[]
  notificationPreferences  NotificationPreference[]
  espFirmwareDeployments   EspFirmwareDeployment[]
  // Phase 2 — server-side alarm correlation.
  correlationRules         CorrelationRule[]
  correlationMatches       CorrelationMatch[]
  rs485Buses            Rs485Bus[]
  rs485Diagnostics      Rs485BusDiagnostic[]
  rs485LatencySamples   Rs485LatencySample[]
}

// role: ADMIN | NOC_OPERATOR | REGIONAL_MANAGER | FIELD_ENGINEER | EXECUTIVE | READONLY
model User {
  id            String    @id @default(cuid())
  tenantId      String
  email         String    @unique
  name          String
  role          Role    @default(NOC_OPERATOR)
  phone         String?
  // bcrypt-hashed password. Nullable for legacy / SSO users that have no
  // local password; the user-management UI always sets a hash on creation
  // and exposes a separate "Reset Password" action.
  passwordHash         String?
  active               Boolean   @default(true)
  lastLoginAt          DateTime?
  // Brute-force protection (Task 31-A). After 5 consecutive failed logins
  // the account is locked for 15 minutes; a successful login resets both.
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  auditLogs  AuditLog[]
  commands   ControlCommand[]
  alarmsAck  Alarm[]     @relation("AlarmAckedBy")
  alarmsRes  Alarm[]     @relation("AlarmResolvedBy")
  tickets    MaintenanceTicket[] @relation("TicketAssignee")
  suppressions AlarmSuppression[]
  notificationPreference NotificationPreference?
  // Task 48 — backup & OTA reverse relations.
  backupRecordsCreated  BackupRecord[] @relation("BackupCreatedBy")
  backupRecordsRestored BackupRecord[] @relation("BackupRestoredBy")
  espFirmwareDeployments EspFirmwareDeployment[]
  // Phase 2 — two-person interlock overrides. Named relations because the same
  // user appears twice per row, once as requester and once as approver.
  interlockOverridesRequested InterlockOverride[] @relation("InterlockOverrideRequested")
  interlockOverridesApproved  InterlockOverride[] @relation("InterlockOverrideApproved")

  @@index([tenantId])
}

// ──────────────────────────────────────────────────────────────────────────
// Geography hierarchy: Region -> Governorate -> District -> Site
// ──────────────────────────────────────────────────────────────────────────

model Region {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  governorates Governorate[]
  sites        Site[]

  // Phase 1: tenantId existed but had NO FK to Tenant, so nothing constrained
  // it. The RLS backstop is weak on an unconstrained column — a bad write
  // would be permanently invisible to every policy. Added here.
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Governorate {
  id        String   @id @default(cuid())
  regionId  String
  name      String
  createdAt DateTime @default(now())

  region     Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  districts  District[]
  sites      Site[]

  @@unique([regionId, name])
}

model District {
  id             String   @id @default(cuid())
  governorateId  String
  name           String
  createdAt      DateTime @default(now())

  governorate Governorate @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  sites       Site[]

  @@unique([governorateId, name])
}

// ──────────────────────────────────────────────────────────────────────────
// Site & assets
// ──────────────────────────────────────────────────────────────────────────

// status: ONLINE | DEGRADED | OFFLINE | MAINTENANCE
// criticality: CRITICAL | HIGH | MEDIUM | LOW
model Site {
  id            String   @id @default(cuid())
  tenantId      String
  code          String   @unique
  name          String
  regionId      String
  governorateId String
  districtId    String
  latitude      Float
  longitude     Float
  address       String
  status        SiteStatus   @default(ONLINE)
  criticality   Criticality   @default(MEDIUM)
  // Load profile (kW)
  loadKw        Float    @default(0)
  // Power preference: GRID | GENERATOR | HYBRID
  powerSource   PowerSource   @default(HYBRID)
  gridAvailable Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  region       Region       @relation(fields: [regionId], references: [id])
  governorate  Governorate  @relation(fields: [governorateId], references: [id])
  district     District     @relation(fields: [districtId], references: [id])

  tanks        FuelTank[]
  generators   Generator[]
  batteries    BatteryBank[]
  iotDevices   IotDevice[]
  dispensers   FuelDispenser[]
  rs485Buses   Rs485Bus[]
  dispenserTransactions FuelTransaction[]
  // Task 48 — site-level ESP32/RS485 edge gateways aggregating dispenser traffic.
  gateways     SiteGateway[]
  alarms       Alarm[]
  deliveries   FuelDelivery[]
  tickets      MaintenanceTicket[]
  events       SiteEvent[]
  suppressions AlarmSuppression[]

  @@index([tenantId])
  @@index([regionId])
  @@index([governorateId])
  @@index([districtId])
}

// fuelType: DIESEL | PETROL | BIOFUEL
// status: OPERATIONAL | EMPTY | MAINTENANCE | CALIBRATING
model FuelTank {
  id            String   @id @default(cuid())
  siteId        String
  // Phase 1 step 2-5: denormalised from the parent Site so the RLS policy is a
  // local `tenant_id = ...` predicate rather than a join. Backfilled from
  // Site.tenantId; ON DELETE RESTRICT, not CASCADE — a tenant holding assets
  // must not be deletable.
  tenantId      String
  label         String
  fuelType      FuelType   @default(DIESEL)
  capacityLitres Float
  // Current live level (litres) — updated by telemetry engine & persisted on tick
  currentLitres Float
  // Calibration curve: JSON array of [{litres, percent}] strapping points
  calibration   String
  // Thresholds (litres)
  lowThreshold  Float
  criticalThreshold Float
  // Telemetry meta
  lastReadingAt DateTime?
  status        TankStatus   @default(OPERATIONAL)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deliveries FuelDelivery[]

  // Phase 1 step 5: the RLS policy filters on tenantId, so the index leads
  // with it. The original siteId index is kept for the existing access paths.
  @@index([tenantId])
  @@index([tenantId, siteId])
  @@index([siteId])
}

// status: RUNNING | STOPPED | FAULT | MAINTENANCE | OFFLINE
// mode: AUTO | MANUAL | REMOTE
model Generator {
  id              String   @id @default(cuid())
  siteId          String
  // Phase 1 step 2-5: denormalised from Site. ControlCommand backfills from
  // this column via `generatorId` (ControlCommand has no siteId of its own).
  tenantId        String
  label           String
  manufacturer    String
  model           String
  ratedPowerKw    Float
  fuelType        String   @default("DIESEL")
  status          GenStatus   @default(STOPPED)
  mode            GenMode   @default(AUTO)
  runtimeHours    Float    @default(0)
  // Maintenance
  oilChangeIntervalHrs Float @default(250)
  lastOilChangeHrs     Float @default(0)
  nextMaintenanceHrs   Float @default(250)
  // Live telemetry (updated by engine)
  temperatureC     Float   @default(65)
  oilPressureKpa   Float   @default(320)
  loadKw           Float   @default(0)
  fuelRateLph      Float   @default(0)
  batteryVoltage   Float   @default(24)
  lastStartedAt    DateTime?
  lastStoppedAt    DateTime?
  lastReadingAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  site     Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  commands ControlCommand[]
  interlockOverrides InterlockOverride[]

  @@index([tenantId])
  @@index([tenantId, siteId])
  @@index([siteId])
}

// status: OK | LOW | FAILING | REPLACEMENT_DUE | OFFLINE
model BatteryBank {
  id            String   @id @default(cuid())
  siteId        String
  tenantId      String   // Phase 1 step 2-5: denormalised from Site.
  label         String
  chemistry     String   @default("VRLA")
  capacityAh    Float
  nominalVoltage Float   @default(48)
  // Live telemetry
  voltage       Float    @default(48)
  currentA      Float    @default(0)
  stateOfCharge Float    @default(80)   // %
  stateOfHealth Float    @default(95)   // %
  temperatureC  Float    @default(25)
  charging      Boolean  @default(false)
  status        BatteryStatus   @default(OK)
  installedAt   DateTime @default(now())
  // Last discharge / service date, used for battery health scoring.
  lastReadingAt DateTime?
  updatedAt     DateTime @updatedAt

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, siteId])
  @@index([siteId])
}

// type: FUEL_SENSOR | GENERATOR_CONTROLLER | BATTERY_SENSOR | POWER_METER | ENVIRONMENTAL
// protocol: RS485 | MODBUS_RTU | MODBUS_TCP | MQTT | HTTP | SNMP
// status: ONLINE | OFFLINE | DEGRADED | PROVISIONING
model IotDevice {
  id          String   @id @default(cuid())
  siteId      String
  tenantId    String   // Phase 1 step 2-5: denormalised from Site.
  name        String
  type        String
  protocol    IotProtocol
  vendor      String
  serialNo    String   @unique
  firmware    String
  ipAddress   String?
  modbusUnit  Int?
  // Online state
  status      IotStatus   @default(ONLINE)
  lastSeenAt  DateTime?
  signalRssi  Int      @default(-70)
  // OTA
  otaTargetFw String?
  otaStatus   String?  // PENDING | IN_PROGRESS | COMPLETE | FAILED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, siteId])
  @@index([siteId])
}

// ──────────────────────────────────────────────────────────────────────────
// Fuel Dispensers (Task 34-B)
// ──────────────────────────────────────────────────────────────────────────
// A fuel dispenser is a physical pump at a site, controlled by an ESP32 /
// ESP8266 board that talks to the platform over RS485 (Modbus RTU). Each
// dispenser has 1–4 nozzles and reports live transaction telemetry
// (in-progress volume, flow rate, totalizer) plus the per-fueling-event
// audit trail (FuelTransaction rows).
//
// status: IDLE | AUTHORIZED | DISPENSING | STOPPED | FAULT | MAINTENANCE | OFFLINE
// mode:   AUTO | MANUAL | LOCKED
// fuelType: DIESEL | PETROL
model FuelDispenser {
  id            String   @id @default(cuid())
  siteId        String
  tenantId      String   // Phase 1 step 2-5: denormalised from Site. Also the
                        // Tier A backfill path for EspFirmwareDeployment.
  label         String
  manufacturer  String
  model         String
  nozzleCount   Int      @default(1)   // 1–4 nozzles
  fuelType      FuelType   @default(DIESEL) // DIESEL | PETROL
  maxFlowLpm    Float    @default(40)  // max litres/min
  status        DispenserStatus   @default(IDLE)
  mode          String   @default("AUTO")
  // Pump identifier 1..N within a site (unique per site). Task 48 — required
  // by /api/fgmp/assets/dispensers (create + unique constraint siteId_pumpNumber),
  // /api/fgmp/dispensers/reports (select + response), and
  // /api/fgmp/edge/firmware/deployments (nested select on dispenser).
  pumpNumber    Int      @default(1)

  // ── ESP controller info ────────────────────────────────────────────────
  espDeviceId     String  @unique       // ESP32 / ESP8266 board id
  espFirmware     String  @default("v1.0.0")
  rs485Baudrate   Int     @default(9600)
  rs485Address    Int     @default(1)   // modbus unit address 1–247
  rs485Parity     String  @default("8N1")
  wifiRssi        Int     @default(-65)
  ipAddress       String?
  lastCommAt      DateTime?

  // ── Live telemetry (updated by engine tick) ───────────────────────────
  currentVolumeLitres  Float    @default(0)   // in-progress transaction volume
  presetVolumeLitres   Float?                 // optional preset limit
  flowRateLpm          Float    @default(0)
  totalizerLitres      Float    @default(0)   // cumulative lifetime volume
  currentTransactionId String?
  lastTransactionAt    DateTime?
  tempC                Float    @default(35)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site         Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  transactions FuelTransaction[]
  // Task 48 — reverse relation for OTA firmware deployments targeting this dispenser.
  espFirmwareDeployments EspFirmwareDeployment[]

  @@index([tenantId])
  @@index([tenantId, siteId])
  @@index([siteId])
  @@index([status])
  // Task 48 — pump identifier 1..N is unique within a site. Referenced by
  // /api/fgmp/assets/dispensers as the `siteId_pumpNumber` compound unique key.
  @@unique([siteId, pumpNumber])
}

// ──────────────────────────────────────────────────────────────────────────
// Fuel Transactions (Task 34-B)
// ──────────────────────────────────────────────────────────────────────────
// Each fueling event on a dispenser. Persisted on completion; the in-progress
// one lives in FuelDispenser.currentTransactionId until the engine finalizes
// it (volume → totalizer → tank decrement).
//
// status: IN_PROGRESS | COMPLETED | CANCELLED | FAILED
model FuelTransaction {
  id            String    @id @default(cuid())
  dispenserId   String
  siteId        String
  tenantId      String    // Phase 1 step 2-5: denormalised from Site.
  nozzle        Int       @default(1)
  volumeLitres  Float
  amountYer     Decimal     @default(0)   // cost in Yemeni Rial
  unitPriceYer  Decimal     @default(0)
  vehiclePlate  String?
  operatorName  String?
  status        FuelTransactionStatus    @default(COMPLETED)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  durationSec   Int       @default(0)
  createdAt     DateTime  @default(now())

  dispenser FuelDispenser @relation(fields: [dispenserId], references: [id], onDelete: Cascade)
  site      Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, siteId])
  @@index([dispenserId, startedAt])
  @@index([siteId, startedAt])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────────────────
// Time-series readings (aggregated; high-frequency telemetry stays in-memory)
// ──────────────────────────────────────────────────────────────────────────

// metric: FUEL_LEVEL | GEN_TEMP | GEN_RUNTIME | BATT_VOLTAGE | BATT_SOC | LOAD_KW | FUEL_RATE
// entityKind: TANK | GENERATOR | BATTERY | SITE
model SensorReading {
  id          String   @id @default(cuid())
  siteId      String
  tenantId    String   // Phase 1 step 2-5: denormalised from Site.
  entityKind  EntityKind
  entityId    String
  metric      String
  value       Float
  ts          DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Step 5 note: this is the table step 10 turns into a hypertable, so the
  // tenant-leading index is also the one the RLS predicate rides on. Keeping
  // (tenantId, ts) lets a per-tenant time-range scan use one index for both.
  @@index([tenantId])
  @@index([tenantId, ts])
  @@index([siteId, ts])
  // Phase 4 item 4. This was a NON-unique index, so a replayed reading was only
  // UNLIKELY to duplicate, never impossible. Making it UNIQUE turns the ingest
  // duplicate check from a best-effort process-local heuristic into a database
  // guarantee: two replicas receiving the same retry both attempt the insert
  // and exactly one succeeds, whether or not they share memory, cache or a
  // Redis connection.
  //
  // This is why the DATABASE is the authority for the watermark and not Redis.
  // A cache can be evicted, flushed, partitioned or absent, and a miss on a
  // stale cache entry lets a duplicate straight through. A unique constraint
  // survives a total cache outage precisely because it does not depend on the
  // cache existing.
  @@unique([entityId, metric, ts])
}

// ──────────────────────────────────────────────────────────────────────────
// Alarms
// ──────────────────────────────────────────────────────────────────────────

// type: FUEL_THEFT | FUEL_REFILL | FUEL_LOW | FUEL_CRITICAL |
//       GEN_OFFLINE | GEN_FAILURE | GEN_OVERHEAT |
//       BATT_LOW_VOLTAGE | BATT_FAILURE | COMM_LOSS
// severity: L1 | L2 | L3   (L3 most severe)
// status: OPEN | ACKNOWLEDGED | RESOLVED | ESCALATED
model Alarm {
  id            String   @id @default(cuid())
  tenantId      String
  siteId        String
  type          AlarmType
  severity      AlarmSeverity   @default(L1)
  status        AlarmStatus   @default(OPEN)
  escalationLevel Int    @default(1)
  entityKind    String?
  entityId      String?
  message       String
  value         Float?
  threshold     Float?
  createdAt     DateTime @default(now())
  acknowledgedAt DateTime?
  acknowledgedById String?
  resolvedAt    DateTime?
  resolvedById  String?
  resolution    String?

  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  // Phase 1: added the FK that was missing on tenantId (see Region).
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  acknowledgedBy User?   @relation("AlarmAckedBy", fields: [acknowledgedById], references: [id])
  resolvedBy   User?     @relation("AlarmResolvedBy", fields: [resolvedById], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([siteId, status])
  @@index([status, severity])
  @@index([createdAt])
  @@index([acknowledgedById])
  @@index([resolvedById])
}

model SiteEvent {
  id        String   @id @default(cuid())
  siteId    String
  tenantId  String   // Phase 1 step 2-5: denormalised from Site.
  kind      String   // INFO | WARN | CRITICAL | CONTROL | DELIVERY
  message   String
  meta      String?  // JSON
  createdAt DateTime @default(now())

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([siteId, createdAt])
}

// ──────────────────────────────────────────────────────────────────────────
// Inventory, deliveries, control, maintenance, audit, notifications
// ──────────────────────────────────────────────────────────────────────────

// status: SCHEDULED | IN_TRANSIT | DELIVERED | VERIFIED | DISCREPANCY | CANCELLED
model FuelDelivery {
  id          String   @id @default(cuid())
  siteId      String
  tenantId    String   // Phase 1 step 2-5: denormalised from Site.
  tankId      String
  supplier    String
  driverName  String?
  vehiclePlate String?
  volumeOrderedLitres Float
  volumeDeliveredLitres Float?
  doNumber    String   // delivery order number
  status      FuelDeliveryStatus   @default(SCHEDULED)
  scheduledAt DateTime
  dispatchedAt DateTime?
  deliveredAt DateTime?
  verifiedAt  DateTime?
  discrepancyNote String?
  unitPrice   Decimal    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tank FuelTank @relation(fields: [tankId], references: [id])

  @@index([tenantId])
  @@index([tenantId, siteId])
  @@index([siteId, status])
  @@index([scheduledAt])
}

// command: START | STOP | EMERGENCY_STOP | RESET
// status: PENDING | SENT | EXECUTED | FAILED | TIMEOUT
model ControlCommand {
  id          String   @id @default(cuid())
  generatorId String
  // Phase 1 step 2-5. ControlCommand is the one table with no `siteId` of its
  // own, so it backfills via generatorId -> Generator.tenantId (two hops).
  // Adding a siteId column was considered and rejected: it would denormalise a
  // relationship the schema already expresses, and the table has no rows.
  tenantId    String
  command     GenCommandType
  status      ControlCommandStatus   @default(PENDING)
  reason      String?
  issuedById  String?
  issuedAt    DateTime @default(now())
  executedAt  DateTime?
  result      String?

  generator Generator @relation(fields: [generatorId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  issuedBy  User?     @relation(fields: [issuedById], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([generatorId, status])
}

/// Phase 2 — safety interlock override audit trail.
///
/// Every interlock DENIAL is recorded, and every two-person OVERRIDE is
/// recorded here with both actors. The two-person rule is only meaningful if
/// the second authorization is separately attributable: an override that just
/// says "approved" cannot be reviewed afterwards to establish who carried the
/// risk.
///
/// Deliberately append-only in practice — it answers "who bypassed a safety
/// interlock, who countersigned it, and why", which is a compliance question
/// long after the fact.
model InterlockOverride {
  id          String   @id @default(cuid())
  tenantId    String
  generatorId String
  /// The command that was refused, and is being overridden.
  command     GenCommandType
  /// InterlockRuleId that produced the refusal.
  ruleId      String
  /// Operator who requested the override.
  requestedById String
  /// Second, higher-authority operator who authorised it. Null when the
  /// override did NOT require two people — kept nullable so a single-tier
  /// override is recorded by the same code path.
  approvedById  String?
  /// Operator's stated justification. Recorded verbatim; overrides without a
  /// reason are how safety controls get normalised away.
  justification String
  createdAt   DateTime @default(now())

  generator   Generator @relation(fields: [generatorId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  requestedBy User      @relation("InterlockOverrideRequested", fields: [requestedById], references: [id])
  approvedBy  User?     @relation("InterlockOverrideApproved", fields: [approvedById], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([generatorId])
}

// type: PREVENTIVE | CORRECTIVE | OIL_CHANGE | INSPECTION | CALIBRATION
// status: OPEN | SCHEDULED | IN_PROGRESS | DONE | CANCELLED
// priority: P1 | P2 | P3 | P4
model MaintenanceTicket {
  id          String   @id @default(cuid())
  siteId      String
  tenantId    String   // Phase 1 step 2-5: denormalised from Site.
  assetKind   String   // GENERATOR | TANK | BATTERY | IOT
  assetId     String
  type        String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority   @default(P3)
  title       String
  description String?
  assignedToId String?
  scheduledFor DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site       Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignedTo User?  @relation("TicketAssignee", fields: [assignedToId], references: [id])

  @@index([tenantId])
  @@index([tenantId, siteId])
  @@index([siteId, status])
  @@index([status, priority])
}

// action: CREATE | UPDATE | DELETE | CONTROL | ACK | RESOLVE | LOGIN | EXPORT | CONFIG
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  entity     String
  entityId   String?
  details    String   // JSON string
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
  // Phase 1: added the FK that was missing on tenantId (see Region).
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@index([userId])
}

// channel: SMS | EMAIL | PUSH | WHATSAPP
// status: QUEUED | SENT | DELIVERED | FAILED
model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  channel   NotificationChannel
  recipient String
  subject   String
  body      String
  alarmId   String?
  status    NotificationStatus   @default(QUEUED)
  attempts  Int      @default(0)
  sentAt    DateTime?
  createdAt DateTime @default(now())

  // Phase 1: added the FK that was missing on tenantId (see Region).
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────────────────
// Alarm Suppression / Maintenance Windows (Task 32-B)
// ──────────────────────────────────────────────────────────────────────────
// Time-bound rule that prevents specific alarm types from firing during
// planned maintenance windows. Used by the alarm engine (raiseAlarm) and
// the suppression-check helper to short-circuit alarm creation when an
// active suppression matches.
//
// Semantics:
//   - siteId IS NULL  → applies to ALL sites (tenant-wide).
//   - alarmType IS NULL → applies to ALL alarm types for the site(s).
//   - isActive = false → rule cancelled (manual or auto after expiry).
//   - The matching logic in src/lib/fgmp/suppression-check.ts treats a
//     rule as "currently suppressing" when isActive=true AND now is
//     between startsAt and endsAt. Expired-but-active rows are ignored
//     by the matcher but kept in the DB for the audit history.
model AlarmSuppression {
  id         String   @id @default(cuid())
  tenantId   String
  siteId     String?  // null = all sites (tenant-wide)
  alarmType  String?  // null = all alarm types (e.g. "FUEL_LOW", "GEN_FAULT")
  reason     String   // human-readable reason for suppression
  createdBy  String
  startsAt   DateTime
  endsAt     DateTime
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  site   Site?  @relation(fields: [siteId], references: [id])
  user   User   @relation(fields: [createdBy], references: [id])

  @@index([tenantId, isActive, endsAt])
  @@index([siteId])
}

// ──────────────────────────────────────────────────────────────────────────
// Per-User Notification Preferences (Task 33-A)
// ──────────────────────────────────────────────────────────────────────────
// Lets each operator customize which alarm notifications they receive, by
// severity and channel (in-app / email / SMS), plus optional quiet hours
// during which in-app notifications are silenced (L3 critical alarms still
// trigger audible alerts). One row per user (1:1).
//
// Semantics:
//   - inAppSeverities / emailSeverities / smsSeverities are comma-separated
//     subsets of {L1,L2,L3} (e.g. "L1,L2,L3"). The notification dispatcher
//     filters a queued alarm by intersecting its severity with the list of
//     the channel the user has enabled.
//   - quietHoursStart / quietHoursEnd are integers 0-23 (AST timezone).
//     When both are null, quiet hours are disabled. When start > end the
//     window wraps past midnight (e.g. 22 → 6 = 10pm → 6am).
//   - emailOverride / phoneOverride are optional contact overrides. When
//     null/empty the dispatcher falls back to user.email / user.phone.
model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  // Tier A (Phase 1 step 2-5): resolved through User.tenantId, not a parent
  // Site — an operator's preferences exist independently of any site.
  tenantId     String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Channels — which delivery methods the user wants
  inAppEnabled  Boolean  @default(true)
  emailEnabled  Boolean  @default(false)
  smsEnabled    Boolean  @default(false)
  // Severity filters — which severities trigger notifications per channel
  inAppSeverities  String  @default("L1,L2,L3")  // comma-separated
  emailSeverities  String  @default("L2,L3")
  smsSeverities    String  @default("L3")
  // Quiet hours — suppress in-app + sound during these hours (24h format, AST timezone)
  quietHoursStart  Int?    // 0-23 (e.g. 22 for 10pm)
  quietHoursEnd    Int?    // 0-23 (e.g. 6 for 6am)
  // Email/SMS contact overrides (optional — defaults to user.email)
  emailOverride    String?
  phoneOverride    String?
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

// ──────────────────────────────────────────────────────────────────────────
// API Keys (Task 35-E) — programmatic access to the FGMP REST API
// ──────────────────────────────────────────────────────────────────────────
// Each key has a SHA-256 hash of the raw secret (only shown once at creation),
// a set of scopes (comma-separated: read,write,control,admin), optional
// IP allowlist, and an expiry. Revoked keys stay in the table for audit.
//
// scopes: comma-separated subset of {read,write,control,admin}
model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  keyPrefix   String    // first 8 chars of the raw key, for identification
  keyHash     String    @unique // SHA-256 hash of the full raw key
  scopes      String    @default("read") // comma-separated
  ipAllowlist String?   // comma-separated CIDRs, null = any IP
  createdBy   String    // user id
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  // Phase 1: added the FK that was missing on tenantId (see Region).
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, revoked])
  @@index([keyHash])
}

// ──────────────────────────────────────────────────────────────────────────
// Shift Handover Log (Round 46) — NOC operator shift handover notes
// ──────────────────────────────────────────────────────────────────────────
// Each NOC is a 24/7 operation: operators rotate across shifts (Morning,
// Evening, Night) and the outgoing operator leaves a structured handover
// note for the incoming operator. This model stores those notes.
//
// Semantics:
//   - shift: MORNING | EVENING | NIGHT  (the shift that PRODUCED the note)
//   - status: OPEN | ACKNOWLEDGED  (OPEN = awaiting the incoming operator
//     to read; ACKNOWLEDGED = incoming operator has confirmed receipt)
//   - openAlarmsCount / criticalSitesCount are point-in-time snapshots the
//     outgoing operator stamps onto the note (so the incoming operator sees
//     the state of the network at handover time without re-deriving it).
//   - priority: P1 | P2 | P3  (operator-set urgency of the handover note)
//   - tenantId: tenant isolation (every operator only sees their tenant's
//     handover log).
//   - createdAt = handover note creation time; acknowledgedAt = when the
//     incoming operator confirmed receipt.
model ShiftHandover {
  id                 String   @id @default(cuid())
  tenantId           String
  authorId           String   // outgoing operator (User.id)
  authorName         String   // denormalized for fast list rendering
  authorRole         String   // denormalized role at handover time
  shift              String   // MORNING | EVENING | NIGHT
  status             String   @default("OPEN")  // OPEN | ACKNOWLEDGED
  priority           String   @default("P3")    // P1 | P2 | P3
  // Outgoing operator's free-form handover notes (required).
  notes              String
  // Optional: ongoing issues the incoming operator should watch.
  ongoingIssues      String?
  // Optional: site ids the outgoing operator flagged for attention.
  flaggedSiteIds     String?  // comma-separated site ids
  // Point-in-time snapshot of the network at handover.
  openAlarmsCount    Int      @default(0)
  criticalSitesCount Int      @default(0)
  avgFuelPct         Float    @default(0)
  // Acknowledgement (incoming operator confirms receipt).
  acknowledgedById   String?
  acknowledgedAt     DateTime?
  acknowledgedNote   String?  // optional reply from the incoming operator
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Phase 1: added the FK that was missing on tenantId (see Region).
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([shift, status])
}

// ──────────────────────────────────────────────────────────────────────────
// System Settings (Task 35-E) — global platform configuration key-value store
// ──────────────────────────────────────────────────────────────────────────
// Simple key-value table for global settings (alarm thresholds, escalation
// timers, branding colors, etc.). Each row is one setting; the UI groups them
// by category. Values are stored as strings; the API coerces to the right type.
//
// category: ALARM | ESCALATION | BRANDING | PLATFORM | FORECAST
model SystemSetting {
  id        String   @id @default(cuid())
  category  SystemSettingCategory
  key       String   @unique
  value     String
  type      String   @default("string") // string | number | boolean | json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category])
}

// ──────────────────────────────────────────────────────────────────────────
// Site Gateways (Task 48) — ESP32/ESP8266 edge gateways
// ──────────────────────────────────────────────────────────────────────────
// A SiteGateway is the ESP32/ESP8266 board that aggregates RS485 traffic
// from one or more fuel dispensers at a site and bridges it to the FGMP
// platform over WiFi/Ethernet. Each gateway reports live health telemetry
// (uptime, CPU temp, heap, WiFi RSSI) every tick.
//
// status: ONLINE | OFFLINE | DEGRADED
model SiteGateway {
  id          String   @id @default(cuid())
  siteId      String
  tenantId    String   // Phase 1 step 2-5: denormalised from Site.
  hostname    String
  // Optional hardware identity, editable via PATCH /api/fgmp/edge/gateways/[id].
  model       String?
  ipAddress   String?
  status      GatewayStatus   @default(ONLINE)  // ONLINE | OFFLINE | DEGRADED
  uptimeSec   Int      @default(0)
  cpuTempC    Float    @default(45)
  heapKb      Int      @default(0)
  wifiRssi    Int      @default(-65)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, siteId])
  @@index([siteId])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────────────────
// ESP Firmware Releases & Deployments (Task 48) — OTA management
// ──────────────────────────────────────────────────────────────────────────
// An EspFirmwareRelease is a versioned firmware image for the ESP32/ESP8266
// controllers on fuel dispensers. Each release tracks its checksum, size,
// channel (stable | beta | hotfix) and release notes; deployments are
// recorded as EspFirmwareDeployment rows that reference a dispenser + a
// release + the initiating user.
//
// channel: stable | beta | hotfix
model EspFirmwareRelease {
  id           String   @id @default(cuid())
  version      String   @unique
  channel      String   @default("stable")  // stable | beta | hotfix
  checksum     String
  sizeKb       Int
  releaseNotes String   @default("")
  releasedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  deployments EspFirmwareDeployment[]

  @@index([channel])
  @@index([releasedAt])
}

// status: QUEUED | DOWNLOADING | FLASHING | SUCCESS | FAILED | ROLLED_BACK
model EspFirmwareDeployment {
  id            String   @id @default(cuid())
  dispenserId   String
  // Tier A (Phase 1 step 2-5): resolved through FuelDispenser.tenantId. A
  // deployment is the tenant-scoped instance of a global EspFirmwareRelease.
  tenantId      String
  releaseId     String
  status        OtaStatus   @default(QUEUED)
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  initiatedById String?

  dispenser   FuelDispenser      @relation(fields: [dispenserId], references: [id], onDelete: Cascade)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  release     EspFirmwareRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  initiatedBy User?              @relation(fields: [initiatedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, dispenserId])
  @@index([dispenserId])
  @@index([status])
  @@index([startedAt])
}

// ──────────────────────────────────────────────────────────────────────────
// Backup Records (Task 48) — SQLite snapshot audit trail
// ──────────────────────────────────────────────────────────────────────────
// Each row records one backup snapshot of the live SQLite database file
// (kind = MANUAL | SCHEDULED | PRE_RESTORE) with its SHA-256 hash, size, and
// the user who created/restored it. The actual .db file lives on disk under
// `backups/`; this table is the audit index.
//
// status: COMPLETED | FAILED | RESTORED
// kind:   MANUAL | SCHEDULED | PRE_RESTORE
model BackupRecord {
  id            String   @id @default(cuid())
  tenantId      String
  filename      String
  sizeBytes     Int      @default(0)
  sha256        String?
  kind          String   @default("MANUAL")
  status        String   @default("COMPLETED")
  note          String?
  createdById   String?
  restoredById  String?
  createdAt     DateTime @default(now())
  restoredAt    DateTime?

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy  User?  @relation("BackupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  restoredBy User?  @relation("BackupRestoredBy", fields: [restoredById], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([status])
}

// ── Phase 2: RS485 / Modbus bus diagnostics ───────────────────────────────
// Persisted rather than derived. The previous implementation reported zeros
// because nothing measured the bus — and a dashboard showing "0 CRC errors" on
// a failing bus is worse than showing nothing, because it looks healthy.
//
// These tables hold what the protocol layer ACTUALLY observed. Every counter is
// incremented at the point the corresponding event happens (see
// src/lib/fgmp/protocol/client.ts); nothing here is synthesised.

/// A physical RS485 segment. Dispensers on one segment share a bus, so bus
/// health is a property of the segment, not of any single dispenser — and two
/// devices configured at the same slave address is a bus-level fault.
model Rs485Bus {
  id            String   @id @default(cuid())
  tenantId      String   // Phase 1: denormalised so RLS can scope the bus.
  label         String
  siteId        String?

  // Bus configuration. These are the values the modem is actually programmed
  // with, and a mismatch between here and a device's own configuration is one
  // of the most common causes of a silent bus.
  baudrate      Int      @default(9600)
  /// Modbus slave address, 1-247. Unique per bus: two devices sharing an
  /// address makes both answers collide and is unrecoverable from software.
  /// Enforced by a unique constraint rather than left to convention.
  unitAddress   Int      @default(1)
  parity        String   @default("8N1")
  stopBits      Int      @default(1)
  dataBits      Int      @default(8)

  online        Boolean  @default(false)
  lastPollAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site          Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  diagnostics   Rs485BusDiagnostic[]

  @@unique([tenantId, unitAddress])
  @@index([tenantId])
  @@index([siteId])
}

/// One row per device per bus: the counters and latencies for that slave.
///
/// Separate from Rs485Bus because bus-level faults (collisions, a shorted
/// trunk) and device-level faults (a dead slave) need different responses, and
/// collapsing them into one table makes the operator's first question — "is the
/// wire broken or is the device dead?" — unanswerable from the data.
model Rs485BusDiagnostic {
  id            String   @id @default(cuid())
  tenantId      String
  busId         String
  /// Modbus slave address, 1-247.
  unitAddress   Int
  /// Prisma model this device is, so a reading can be attributed to an asset.
  deviceKind    String
  deviceId      String

  // Counters since the row was created. Monotonic by design: an operator needs
  // to see that errors are accumulating, and a counter that resets itself is
  // indistinguishable from a bus that is healthy.
  crcErrors         Int      @default(0)
  timeouts          Int      @default(0)
  retries           Int      @default(0)
  retriesExhausted  Int      @default(0)
  exceptionResponses Int     @default(0)
  successfulReads   Int      @default(0)
  failedReads       Int      @default(0)

  lastLatencyMs     Float    @default(0)
  averageLatencyMs  Float?
  lastPollAt        DateTime?
  lastError         String?
  /// ModbusFailureKind: timeout | crc-mismatch | short-frame | address-echo |
  /// function-code | exception-response | illegal-value. Stored as text
  /// because the set is open and a new failure kind must not require a
  /// migration on a live device fleet.
  lastErrorKind     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bus           Rs485Bus             @relation(fields: [busId], references: [id], onDelete: Cascade)
  samples       Rs485LatencySample[]

  @@unique([busId, unitAddress])
  @@index([tenantId])
  @@index([deviceKind, deviceId])
}

/// Rolling samples of per-poll latency.
///
/// Kept as raw samples rather than only aggregates because the SHAPE of the
/// distribution is diagnostic: a bimodal latency on an RS485 segment usually
/// means two devices are fighting for the bus, which an average hides
/// completely. Bounded by the poller so the table cannot grow without limit.
model Rs485LatencySample {
  id            String   @id @default(cuid())
  tenantId      String
  diagnosticId  String
  unitAddress   Int
  latencyMs     Float
  ok            Boolean
  recordedAt    DateTime @default(now())

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  diagnostic    Rs485BusDiagnostic     @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)

  @@index([tenantId, recordedAt])
  @@index([diagnosticId, recordedAt])
}
