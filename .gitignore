# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# `.env*` also matched `.env.example`, so the documented template could never be
# committed and a fresh checkout had no reference for the required variables.
# Secrets stay ignored; the template is tracked deliberately.
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Tool-result artifacts (transient outputs from bash/read tool calls)
/tool-results/

# Live DB snapshot (mutated continuously by the telemetry engine)
/db/custom.db
/db/custom.db-journal
/db/*.db
/db/*.db-journal

# DB backups (auto-generated by backup jobs)
/backups/

# ── Non-app artifacts: deliverables, uploads, one-off scripts ──────────────
# These are workspace files (proposal documents, generated PDFs, user uploads,
# spent one-off build scripts) that are NOT part of the Next.js application.
# Keeping them out of git prevents them from (a) failing the publish-step
# ESLint check (docx_build_*.js had require() lint errors) and (b) bloating
# the deployment artifact with ~40 MB of binary documents.
*.docx
*.pdf
/upload/
/download/
/docx_build_*.js
/docx_*.py
/docx_transform.py
/docx_embed.py
/FGMP_Arabic_Technical_Proposal*
/worklog.md

# ── QA screenshots & proposal images (not app assets) ──────────────────────
# These are development/QA artifacts (browser screenshots, proposal mockups)
# that bloat the deploy artifact by ~18MB. They are NOT referenced by the
# Next.js app. App assets live in /public/ (logo.svg, robots.txt) and are
# NOT affected by these rules.
/qa-shots/
/verify/
/proposal_imgs/
/heatmap-filter-active.png
# Harness/agent tooling state (not project source)
.mimosa/
